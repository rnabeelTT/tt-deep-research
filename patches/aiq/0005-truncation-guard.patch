+class TruncationGuardMiddleware(AgentMiddleware):
+    """Stops a run whose replies keep hitting max_tokens.
+
+    A reply cut off mid-thought has no tool call, so structured-output agents retry, and each
+    retry thinks to the limit again. After one truncated reply this turns thinking off for the
+    rest of the run; after ``max_truncations`` it also asks for the final result outright.
+    """
+
+    def __init__(self, max_truncations: int = 3):
+        """Configure how many truncated replies to allow before demanding the result."""
+        self.max_truncations = max_truncations
+
+    @staticmethod
+    def _truncated(messages) -> int:
+        return sum(
+            1
+            for m in messages
+            if isinstance(m, AIMessage) and (m.response_metadata or {}).get("finish_reason") == "length"
+        )
+
+    @staticmethod
+    def _no_thinking(request):
+        extra = dict(getattr(request.model, "extra_body", None) or {})
+        extra.update(request.model_settings.get("extra_body") or {})
+        if "reasoning_effort" in extra:
+            extra["reasoning_effort"] = "low"
+        else:
+            extra["chat_template_kwargs"] = {**extra.get("chat_template_kwargs", {}), "enable_thinking": False}
+        return {**request.model_settings, "extra_body": extra}
+
+    def _guard(self, request):
+        n = self._truncated(request.messages)
+        if not n:
+            return request
+        logger.warning("%d truncated replies in this run; thinking off", n)
+        messages = request.messages
+        if n >= self.max_truncations:
+            note = HumanMessage(
+                content="Your replies keep running past the length limit. Stop reasoning and "
+                "return your final result now, briefly, from what you already have."
+            )
+            messages = [*messages, note]
+        return request.override(model_settings=self._no_thinking(request), messages=messages)
+
+    def wrap_model_call(self, request, handler):
+        """Turn thinking off (and demand the result) after truncated replies."""
+        return handler(self._guard(request))
+
+    async def awrap_model_call(self, request, handler):
+        """Turn thinking off (and demand the result) after truncated replies."""
+        return await handler(self._guard(request))
+
+
