+class SourceCallCapMiddleware(AgentMiddleware):
+    """Removes source tools once an agent run has made ``max_calls`` source calls.
+
+    Smaller models may keep searching indefinitely; without the tools they can only
+    return their structured result.
+    """
+
+    def __init__(self, source_tool_names: set[str], max_calls: int = 40):
+        """Configure which tools count as source tools and the per-run cap."""
+        self.source_tool_names = source_tool_names
+        self.max_calls = max_calls
+
+    async def awrap_model_call(self, request, handler):
+        """Drop source tools and ask for the final result once the cap is reached."""
+        calls = sum(
+            tc["name"] in self.source_tool_names
+            for msg in request.messages
+            if isinstance(msg, AIMessage)
+            for tc in msg.tool_calls
+        )
+        if calls < self.max_calls:
+            return await handler(request)
+        tools = [t for t in request.tools if getattr(t, "name", None) not in self.source_tool_names]
+        note = HumanMessage(
+            content=f"You have made {calls} source calls, the limit for this task. "
+            "Stop searching and return your final result now from what you have found."
+        )
+        return await handler(request.override(tools=tools, messages=[*request.messages, note]))
+
