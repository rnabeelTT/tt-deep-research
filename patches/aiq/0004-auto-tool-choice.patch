+def auto_tool_choice_enabled() -> bool:
+    """Opt-in: AIQ_AUTO_TOOL_CHOICE=1."""
+    return os.environ.get("AIQ_AUTO_TOOL_CHOICE") == "1"
+
+
+class AutoToolChoiceMiddleware(AgentMiddleware):
+    """Lets the model choose its tools instead of forcing the structured-output tool.
+
+    LangChain's ToolStrategy forces tool_choice on every turn of an agent with a response
+    format. Some servers serve a forced choice with guided decoding, which can slow every
+    request in the batch. The StructuredResponseTextFallbackMiddleware on those agents
+    recovers the result when the model replies in JSON text instead.
+    """
+
+    @staticmethod
+    def _auto(model):
+        if getattr(model, "_auto_tool_choice", False) or not hasattr(model, "bind_tools"):
+            return
+        bind_tools = model.bind_tools
+
+        def unforced(tools, *, tool_choice=None, **kwargs):
+            if tool_choice in ("any", "required"):
+                tool_choice = "auto"
+            return bind_tools(tools, tool_choice=tool_choice, **kwargs)
+
+        object.__setattr__(model, "bind_tools", unforced)
+        object.__setattr__(model, "_auto_tool_choice", True)
+
+    def wrap_model_call(self, request, handler):
+        """Unforce tool choice on the request's model."""
+        self._auto(request.model)
+        return handler(request)
+
+    async def awrap_model_call(self, request, handler):
+        """Unforce tool choice on the request's model."""
+        self._auto(request.model)
+        return await handler(request)
+
