@@ -202,3 +202,61 @@ export const formatPayload = (payload: string): string => {
 
   return cleaned
 }
+
+/**
+ * Input and output sections of a NAT step payload, with HTML entities decoded
+ * and only the outer code fence removed (inner text is kept verbatim).
+ */
+export interface PayloadSections {
+  input?: string
+  output?: string
+}
+
+const decodeEntities = (text: string): string =>
+  text.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')
+
+const unfence = (text: string): string =>
+  decodeEntities(
+    text
+      .trim()
+      .replace(/^```[\w-]*\n?/, '')
+      .replace(/\n?```$/, '')
+  )
+
+/**
+ * Split a NAT step payload into its input and output sections.
+ * Backend format (nat/front_ends/fastapi/step_adaptor.py):
+ * "**Input:**" / "**Function Input:**" fenced block, optionally followed by
+ * "**Output:**" / "**Function Output:**" (fenced, except for LLM output).
+ */
+export const parsePayloadSections = (payload: string): PayloadSections => {
+  if (!payload) return {}
+  const outputMatch = payload.match(/\*\*(?:Function )?Output:\*\*/i)
+  const outputIndex = outputMatch?.index ?? -1
+  const inputText = (outputIndex >= 0 ? payload.slice(0, outputIndex) : payload).replace(
+    /^\s*\*\*(?:Function )?Input:\*\*/i,
+    ''
+  )
+
+  const sections: PayloadSections = {}
+  if (inputText.trim()) sections.input = unfence(inputText)
+  if (outputMatch) sections.output = unfence(payload.slice(outputIndex + outputMatch[0].length))
+  return sections
+}
+
+/**
+ * Parse a tool input string into an object: JSON objects are parsed, anything
+ * else (e.g. a Python repr) is wrapped in the { _raw } sentinel ToolCallCard understands.
+ */
+export const parseToolInput = (input?: string): Record<string, unknown> | undefined => {
+  if (!input) return undefined
+  try {
+    const parsed = JSON.parse(input)
+    if (typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)) {
+      return parsed as Record<string, unknown>
+    }
+  } catch {
+    // Not JSON -- fall through to the raw sentinel
+  }
+  return { _raw: input }
+}
