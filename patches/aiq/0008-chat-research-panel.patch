+// SPDX-FileCopyrightText: Copyright (c) 2025-2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+import { describe, test, expect } from 'vitest'
+import { parsePayloadSections, parseToolInput } from './intermediate-step-parser'
+
+describe('parsePayloadSections', () => {
+  test('splits a tool end payload and keeps inner text verbatim', () => {
+    const payload =
+      "**Input:**\n```python\n{'query': 'tt &amp; ai'}\n```\n\n**Output:**\n```python\nResult with ```code``` &lt;b&gt;\n```"
+
+    expect(parsePayloadSections(payload)).toEqual({
+      input: "{'query': 'tt & ai'}",
+      output: 'Result with ```code``` <b>',
+    })
+  })
+
+  test('returns only input for a start payload', () => {
+    expect(parsePayloadSections('**Function Input:**\n```json\n{"q": 1}\n```')).toEqual({
+      input: '{"q": 1}',
+    })
+  })
+
+  test('handles a function complete payload with input glued to the output header', () => {
+    const payload =
+      "**Function Input:**\n```python\nstate\n```**Function Output:**\n```python\nIntentResult(intent='research')\n```"
+
+    expect(parsePayloadSections(payload)).toEqual({
+      input: 'state',
+      output: "IntentResult(intent='research')",
+    })
+  })
+
+  test('reads unfenced LLM output', () => {
+    expect(parsePayloadSections('**Input:**\n```python\n[msg]\n```\n\n**Output:**\nHello world')).toEqual({
+      input: '[msg]',
+      output: 'Hello world',
+    })
+  })
+
+  test('returns nothing for an empty payload', () => {
+    expect(parsePayloadSections('')).toEqual({})
+  })
+})
+
+describe('parseToolInput', () => {
+  test('parses JSON objects', () => {
+    expect(parseToolInput('{"query": "x"}')).toEqual({ query: 'x' })
+  })
+
+  test('wraps non-JSON input in the raw sentinel', () => {
+    expect(parseToolInput("{'query': 'x'}")).toEqual({ _raw: "{'query': 'x'}" })
+  })
+
+  test('returns undefined for missing input', () => {
+    expect(parseToolInput(undefined)).toBeUndefined()
+  })
+})
