+import { render, screen, waitFor } from '@/test-utils'
+import userEvent from '@testing-library/user-event'
+import { vi, describe, test, expect, beforeEach } from 'vitest'
+import { CollectionsSection } from './CollectionsSection'
+
+const client = {
+  listCollections: vi.fn(),
+  listFiles: vi.fn(),
+  createCollection: vi.fn(),
+  uploadFiles: vi.fn(),
+  getJobStatus: vi.fn(),
+  deleteFiles: vi.fn(),
+}
+
+vi.mock('@/adapters/api', () => ({ createDocumentsClient: () => client }))
+vi.mock('@/adapters/auth', () => ({ useAuth: () => ({ idToken: undefined }) }))
+vi.mock('@/shared/context', () => ({ useAppConfig: () => ({ fileUpload: { acceptedTypes: '.pdf,.md' } }) }))
+vi.mock('@/features/documents', () => ({ mapToDisplayStatus: (status: string) => status }))
+vi.mock('./FileSourceCard', () => ({
+  FileSourceCard: ({ title, onDelete, id }: { title: string; id: string; onDelete: (id: string) => void }) => (
+    <button onClick={() => onDelete(id)}>{title}</button>
+  ),
+}))
+
+const layout = {
+  enabledDataSourceIds: ['web'],
+  setEnabledDataSources: vi.fn((ids: string[]) => (layout.enabledDataSourceIds = ids)),
+  refreshDataSourceStatus: vi.fn(async () => {}),
+}
+vi.mock('../store', () => {
+  const useLayoutStore = (selector: (s: typeof layout) => unknown) => selector(layout)
+  useLayoutStore.getState = () => layout
+  return { useLayoutStore }
+})
+
+const collection = (name: string, files = 0, description: string | null = null) => ({
+  name,
+  description,
+  file_count: files,
+  chunk_count: 0,
+  backend: 'qdrant',
+  metadata: {},
+})
+
+const file = (name: string, status = 'success') => ({
+  file_id: `id-${name}`,
+  file_name: name,
+  collection_name: 'contracts',
+  status,
+  file_size: 10,
+  chunk_count: 1,
+  metadata: {},
+})
+
+describe('CollectionsSection', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    layout.enabledDataSourceIds = ['web']
+    client.listCollections.mockResolvedValue([collection('library', 3), collection('contracts', 1, 'Signed leases')])
+    client.listFiles.mockResolvedValue([file('lease.pdf')])
+  })
+
+  test('lists named collections, not the chat uploads', async () => {
+    render(<CollectionsSection />)
+    expect(await screen.findByText('contracts')).toBeInTheDocument()
+    expect(screen.getByText('Signed leases')).toBeInTheDocument()
+    expect(screen.getByText('Collections (1)')).toBeInTheDocument()
+    expect(screen.queryByText('library')).not.toBeInTheDocument()
+  })
+
+  test('creates a collection with its description and opens it', async () => {
+    const user = userEvent.setup()
+    client.createCollection.mockResolvedValue(collection('hr'))
+    render(<CollectionsSection />)
+    await user.click(await screen.findByText('+ New collection'))
+    await user.type(screen.getByLabelText('Collection name'), 'HR')
+    await user.type(screen.getByLabelText('Collection description'), 'Policies')
+    await user.click(screen.getByText('Create'))
+    expect(client.createCollection).toHaveBeenCalledWith('hr', 'Policies')
+  })
+
+  test('refuses a name the backend would reject', async () => {
+    const user = userEvent.setup()
+    render(<CollectionsSection />)
+    await user.click(await screen.findByText('+ New collection'))
+    await user.type(screen.getByLabelText('Collection name'), 'my docs!')
+    await user.click(screen.getByText('Create'))
+    expect(client.createCollection).not.toHaveBeenCalled()
+    expect(screen.getByText(/lowercase letters, digits/)).toBeInTheDocument()
+  })
+
+  test('uploads into the open collection, waits for indexing, then switches it on', async () => {
+    const user = userEvent.setup()
+    client.uploadFiles.mockResolvedValue({ job_id: 'j1', file_ids: ['f1'] })
+    client.getJobStatus.mockResolvedValue({ status: 'completed' })
+    render(<CollectionsSection />)
+    await user.click(await screen.findByText('contracts'))
+    expect(await screen.findByText('lease.pdf')).toBeInTheDocument()
+    const memo = new File(['rent'], 'memo.md', { type: 'text/markdown' })
+    await user.upload(screen.getByLabelText('Add files to collection'), memo)
+    await waitFor(() => expect(layout.setEnabledDataSources).toHaveBeenCalledWith(['web', 'docs:contracts']))
+    expect(client.uploadFiles).toHaveBeenCalledWith('contracts', [memo])
+    expect(layout.refreshDataSourceStatus).toHaveBeenCalled()
+  })
+
+  test('deletes a file from its collection', async () => {
+    const user = userEvent.setup()
+    render(<CollectionsSection />)
+    await user.click(await screen.findByText('contracts'))
+    await user.click(await screen.findByText('lease.pdf'))
+    expect(client.deleteFiles).toHaveBeenCalledWith('contracts', ['id-lease.pdf'])
+  })
+})
