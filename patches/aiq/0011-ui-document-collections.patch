+/**
+ * CollectionsSection Component
+ *
+ * Named document collections beside the chat's uploads: create one (name and a description the
+ * agents read), add files to it, watch them index, delete them. Each collection with documents is
+ * a data source the user switches on or off; a collection's first upload switches it on.
+ */
+
+'use client'
+
+import { type FC, useCallback, useEffect, useRef, useState } from 'react'
+import { Flex, Text, Button, Banner } from '@/adapters/ui'
+import { createDocumentsClient } from '@/adapters/api'
+import type { CollectionInfo, FileInfo } from '@/adapters/api/documents-schemas'
+import { useAuth } from '@/adapters/auth'
+import { useAppConfig } from '@/shared/context'
+import { mapToDisplayStatus } from '@/features/documents'
+import { useLayoutStore } from '../store'
+import { FileSourceCard } from './FileSourceCard'
+
+/** The chats' shared uploads, listed above this section. */
+const UPLOADS = 'library'
+const NAME = /^[a-z0-9][a-z0-9_-]{0,47}$/
+const POLL_MS = 3000
+
+const message = (e: unknown): string => (e instanceof Error ? e.message : String(e))
+
+const inputClass =
+  'w-full rounded border border-base bg-surface-raised px-3 py-2 text-sm text-primary outline-none focus:border-brand'
+
+export const CollectionsSection: FC = () => {
+  const { idToken } = useAuth()
+  const { fileUpload } = useAppConfig()
+  const client = useRef(createDocumentsClient({ authToken: idToken }))
+  const refreshDataSourceStatus = useLayoutStore((s) => s.refreshDataSourceStatus)
+
+  const [collections, setCollections] = useState<CollectionInfo[]>([])
+  const [files, setFiles] = useState<Record<string, FileInfo[]>>({})
+  const [open, setOpen] = useState<string | null>(null)
+  const [creating, setCreating] = useState(false)
+  const [name, setName] = useState('')
+  const [description, setDescription] = useState('')
+  const [indexing, setIndexing] = useState<string | null>(null)
+  const [error, setError] = useState<string | null>(null)
+  const fileInput = useRef<HTMLInputElement>(null)
+
+  useEffect(() => {
+    client.current = createDocumentsClient({ authToken: idToken })
+  }, [idToken])
+
+  const loadCollections = useCallback(async () => {
+    const all = await client.current.listCollections()
+    setCollections(all.filter((c) => c.name !== UPLOADS))
+  }, [])
+
+  const loadFiles = useCallback(async (collection: string) => {
+    const list = await client.current.listFiles(collection)
+    setFiles((current) => ({ ...current, [collection]: list }))
+  }, [])
+
+  useEffect(() => {
+    loadCollections().catch((e) => setError(message(e)))
+  }, [loadCollections])
+
+  const toggle = useCallback(
+    (collection: string) => {
+      const next = open === collection ? null : collection
+      setOpen(next)
+      if (next) loadFiles(next).catch((e) => setError(message(e)))
+    },
+    [open, loadFiles]
+  )
+
+  /** List the collection as a data source and switch it on, keeping the user's other choices. */
+  const enable = useCallback(
+    async (collection: string) => {
+      await refreshDataSourceStatus(idToken)
+      const { enabledDataSourceIds, setEnabledDataSources } = useLayoutStore.getState()
+      const id = `docs:${collection}`
+      if (!enabledDataSourceIds.includes(id)) setEnabledDataSources([...enabledDataSourceIds, id])
+    },
+    [idToken, refreshDataSourceStatus]
+  )
+
+  const create = useCallback(async () => {
+    if (!NAME.test(name)) {
+      setError('A collection name is lowercase letters, digits, - and _ (up to 48).')
+      return
+    }
+    try {
+      await client.current.createCollection(name, description.trim() || undefined)
+      await loadCollections()
+      setFiles((current) => ({ ...current, [name]: [] }))
+      setOpen(name)
+      setCreating(false)
+      setName('')
+      setDescription('')
+      setError(null)
+    } catch (e) {
+      setError(message(e))
+    }
+  }, [name, description, loadCollections])
+
+  const upload = useCallback(
+    async (collection: string, picked: File[]) => {
+      setIndexing(collection)
+      setError(null)
+      try {
+        const { job_id } = await client.current.uploadFiles(collection, picked)
+        await loadFiles(collection)
+        for (;;) {
+          const job = await client.current.getJobStatus(job_id)
+          if (!job || job.status === 'completed' || job.status === 'failed') break
+          await new Promise((resolve) => setTimeout(resolve, POLL_MS))
+          await loadFiles(collection)
+        }
+        await loadFiles(collection)
+        await loadCollections()
+        await enable(collection)
+      } catch (e) {
+        setError(message(e))
+      } finally {
+        setIndexing(null)
+      }
+    },
+    [loadFiles, loadCollections, enable]
+  )
+
+  const remove = useCallback(
+    async (collection: string, fileId: string) => {
+      try {
+        await client.current.deleteFiles(collection, [fileId])
+        await loadFiles(collection)
+        await loadCollections()
+      } catch (e) {
+        setError(message(e))
+      }
+    },
+    [loadFiles, loadCollections]
+  )
+
+  return (
+    <Flex direction="col" gap="2" className="mt-6 border-t border-base pt-4">
+      <input
+        ref={fileInput}
+        type="file"
+        multiple
+        accept={fileUpload.acceptedTypes}
+        className="hidden"
+        aria-label="Add files to collection"
+        onChange={(e) => {
+          const picked = Array.from(e.target.files || [])
+          if (open && picked.length > 0) void upload(open, picked)
+          e.target.value = ''
+        }}
+      />
+
+      <Flex align="center" justify="between" className="mb-1">
+        <Text kind="label/semibold/xs" className="text-subtle uppercase">
+          Collections ({collections.length})
+        </Text>
+        <Button kind="tertiary" size="small" onClick={() => setCreating((c) => !c)}>
+          + New collection
+        </Button>
+      </Flex>
+      <Text kind="body/regular/sm" className="text-subtle">
+        Named sets of documents, shared by every chat. Switch each one on or off under Connections.
+      </Text>
+
+      {error && (
+        <Banner kind="inline" status="error" onClose={() => setError(null)}>
+          {error}
+        </Banner>
+      )}
+
+      {creating && (
+        <Flex direction="col" gap="2" className="rounded border border-base p-3">
+          <input
+            className={inputClass}
+            placeholder="name, e.g. contracts"
+            aria-label="Collection name"
+            value={name}
+            onChange={(e) => setName(e.target.value.toLowerCase())}
+          />
+          <input
+            className={inputClass}
+            placeholder="What's in it (the agents read this)"
+            aria-label="Collection description"
+            value={description}
+            onChange={(e) => setDescription(e.target.value)}
+          />
+          <Flex gap="2" justify="end">
+            <Button kind="tertiary" size="small" onClick={() => setCreating(false)}>
+              Cancel
+            </Button>
+            <Button kind="primary" size="small" onClick={() => void create()} disabled={!name}>
+              Create
+            </Button>
+          </Flex>
+        </Flex>
+      )}
+
+      {collections.map((c) => (
+        <Flex key={c.name} direction="col" gap="2" className="rounded border border-base p-3">
+          <button
+            type="button"
+            className="flex w-full items-start justify-between gap-2 text-left"
+            aria-expanded={open === c.name}
+            onClick={() => toggle(c.name)}
+          >
+            <Flex direction="col" gap="1">
+              <Text kind="label/semibold/sm">{c.name}</Text>
+              {c.description && (
+                <Text kind="body/regular/xs" className="text-subtle">
+                  {c.description}
+                </Text>
+              )}
+            </Flex>
+            <Text kind="body/regular/xs" className="text-subtle whitespace-nowrap">
+              {indexing === c.name ? 'Indexing…' : `${c.file_count} file${c.file_count === 1 ? '' : 's'}`}
+            </Text>
+          </button>
+
+          {open === c.name && (
+            <Flex direction="col" gap="2">
+              {(files[c.name] ?? []).map((f) => (
+                <FileSourceCard
+                  key={f.file_id}
+                  id={f.file_id}
+                  title={f.file_name}
+                  fileSize={f.file_size}
+                  uploadedAt={f.uploaded_at}
+                  status={mapToDisplayStatus(f.status)}
+                  errorMessage={f.error_message ?? undefined}
+                  onDelete={(id) => void remove(c.name, id)}
+                />
+              ))}
+              <Button
+                kind="tertiary"
+                size="small"
+                disabled={indexing !== null}
+                onClick={() => fileInput.current?.click()}
+              >
+                + Add files
+              </Button>
+            </Flex>
+          )}
+        </Flex>
+      ))}
+    </Flex>
+  )
+}
