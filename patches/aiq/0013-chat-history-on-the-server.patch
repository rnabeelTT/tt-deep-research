@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: Apache-2.0
+
+import { describe, test, expect, vi, beforeEach, afterEach } from 'vitest'
+
+import { createChatHistory } from './chat-history'
+
+type State = { currentConversation: string | null; conversations: { id: string; title: string }[] }
+
+/** The backend's /v1/chats for one owner, as fetch sees it through the proxy. */
+const server = () => {
+  const conversations = new Map<string, string>()
+  let state: string | null = null
+  const calls: string[] = []
+  const fetchMock = vi.fn(async (url: string, init?: RequestInit) => {
+    const method = init?.method ?? 'GET'
+    const id = decodeURIComponent(url.replace('/api/v1/chats', '').replace(/^\//, ''))
+    calls.push(`${method} ${id}`.trim())
+    if (method === 'GET') {
+      const body = {
+        state: state && JSON.parse(state),
+        conversations: [...conversations.values()].map((c) => JSON.parse(c)),
+      }
+      return new Response(JSON.stringify(body))
+    }
+    if (method === 'DELETE') conversations.delete(id)
+    else if (id) conversations.set(id, init!.body as string)
+    else state = init!.body as string
+    return new Response('{}')
+  })
+  return { conversations, calls, fetchMock, state: () => state }
+}
+
+const value = (
+  conversations: State['conversations'],
+  currentConversation: string | null = null
+) => ({
+  state: { currentConversation, conversations },
+  version: 0,
+})
+
+describe('createChatHistory', () => {
+  let backend: ReturnType<typeof server>
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    backend = server()
+    vi.stubGlobal('fetch', backend.fetchMock)
+    localStorage.clear()
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+    vi.unstubAllGlobals()
+  })
+
+  const settle = async () => {
+    await vi.runAllTimersAsync()
+  }
+
+  test('saves nothing before the history has loaded', async () => {
+    backend.conversations.set('c1', JSON.stringify({ id: 'c1', title: 'Capex' }))
+    const history = createChatHistory<State>()
+    history.save(value([]))
+    await settle()
+    expect(backend.conversations.has('c1')).toBe(true)
+    expect(backend.calls).toEqual([])
+  })
+
+  test('loads the saved chats, then sends only what changed', async () => {
+    backend.conversations.set('c1', JSON.stringify({ id: 'c1', title: 'Capex' }))
+    const history = createChatHistory<State>()
+    const loaded = await history.load()
+    expect(loaded?.state.conversations).toEqual([{ id: 'c1', title: 'Capex' }])
+    backend.calls.length = 0
+
+    history.save(
+      value(
+        [
+          { id: 'c1', title: 'Capex' },
+          { id: 'c2', title: 'Revenue' },
+        ],
+        'c2'
+      )
+    )
+    await settle()
+    expect(backend.calls.sort()).toEqual(['POST', 'POST c2'])
+    expect(JSON.parse(backend.state()!)).toEqual({ currentConversation: 'c2' })
+  })
+
+  test('debounces a burst of saves into one write of the last value', async () => {
+    const history = createChatHistory<State>()
+    await history.load()
+    backend.calls.length = 0
+    for (const title of ['R', 'Re', 'Rev']) history.save(value([{ id: 'c1', title }]))
+    await settle()
+    expect(backend.calls.filter((c) => c === 'POST c1')).toHaveLength(1)
+    expect(JSON.parse(backend.conversations.get('c1')!).title).toBe('Rev')
+  })
+
+  test('deletes only conversations this tab has seen', async () => {
+    backend.conversations.set('c1', JSON.stringify({ id: 'c1', title: 'Capex' }))
+    const history = createChatHistory<State>()
+    await history.load()
+    backend.conversations.set('other-tab', JSON.stringify({ id: 'other-tab', title: 'New' }))
+    history.save(value([]))
+    await settle()
+    expect([...backend.conversations.keys()]).toEqual(['other-tab'])
+  })
+
+  test('moves chats kept in localStorage to the server once', async () => {
+    const legacy = { state: { conversations: [{ id: 'old', title: 'Before' }] }, version: 0 }
+    localStorage.setItem('aiq-chat-store', JSON.stringify(legacy))
+    const loaded = await createChatHistory<State>().load()
+    expect(loaded?.state.conversations).toEqual([{ id: 'old', title: 'Before' }])
+    expect(backend.conversations.has('old')).toBe(true)
+    expect(localStorage.getItem('aiq-chat-store')).toBeNull()
+  })
+
+  test('an unreachable server loads nothing and saves nothing', async () => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => new Response('', { status: 502 }))
+    )
+    const history = createChatHistory<State>()
+    expect(await history.load()).toBeNull()
+    history.save(value([{ id: 'c1', title: 'Capex' }]))
+    await settle()
+    expect(fetch).toHaveBeenCalledTimes(1)
+  })
+})
diff --git a/frontends/ui/src/features/chat/lib/chat-history.ts b/frontends/ui/src/features/chat/lib/chat-history.ts
new file mode 100644
index 0000000..eec2563
--- /dev/null
+++ b/frontends/ui/src/features/chat/lib/chat-history.ts
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Chat history on the server (the backend's /v1/chats, through the /api/v1 proxy, which names
+ * this browser with a cookie), one document per conversation. It outlives localStorage's quota
+ * and follows the browser across ports.
+ *
+ * Saves are debounced and send only what changed. Nothing is saved before the history has
+ * loaded, and a tab deletes only conversations it has seen, so a tab never wipes chats it
+ * doesn't know about (another tab's new chat, or the history while it loads).
+ */
+
+import type { StorageValue } from 'zustand/middleware'
+
+const API = '/api/v1/chats'
+const LEGACY_KEY = 'aiq-chat-store'
+const SAVE_DELAY_MS = 500
+
+type Stored = { id: string }
+type History<S> = S & { conversations: Stored[] }
+
+const post = (path: string, json: string): Promise<boolean> =>
+  fetch(`${API}${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: json,
+  })
+    .then((r) => r.ok)
+    .catch(() => false)
+
+const remove = (id: string): Promise<boolean> =>
+  fetch(`${API}/${encodeURIComponent(id)}`, { method: 'DELETE' })
+    .then((r) => r.ok)
+    .catch(() => false)
+
+/** Chats this browser kept in localStorage before the history moved to the server. */
+const legacyConversations = (): Stored[] => {
+  try {
+    return JSON.parse(localStorage.getItem(LEGACY_KEY) ?? 'null')?.state?.conversations ?? []
+  } catch {
+    return []
+  }
+}
+
+export const createChatHistory = <S extends { conversations: Stored[] }>() => {
+  const saved = new Map<string, string>()
+  let savedState = ''
+  let loaded = false
+  let pending: StorageValue<History<S>> | null = null
+  let timer: ReturnType<typeof setTimeout> | null = null
+  let queue = Promise.resolve()
+
+  const flush = async () => {
+    timer = null
+    const value = pending
+    pending = null
+    if (!value) return
+    const { conversations, ...state } = value.state
+    const current = new Map(conversations.map((c) => [c.id, JSON.stringify(c)]))
+    const writes: Promise<void>[] = [...current]
+      .filter(([id, json]) => saved.get(id) !== json)
+      .map(async ([id, json]) => {
+        if (await post(`/${encodeURIComponent(id)}`, json)) saved.set(id, json)
+      })
+    const deletes = [...saved.keys()]
+      .filter((id) => !current.has(id))
+      .map(async (id) => {
+        if (await remove(id)) saved.delete(id)
+      })
+    const stateJson = JSON.stringify(state)
+    if (stateJson !== savedState) {
+      writes.push(
+        (async () => {
+          if (await post('', stateJson)) savedState = stateJson
+        })()
+      )
+    }
+    await Promise.all([...writes, ...deletes])
+  }
+
+  const load = async (): Promise<StorageValue<History<S>> | null> => {
+    const response = await fetch(API).catch(() => null)
+    if (!response?.ok) return null
+    const body: { state: Omit<S, 'conversations'> | null; conversations: Stored[] } =
+      await response.json()
+    let conversations = body.conversations
+    conversations.forEach((c) => saved.set(c.id, JSON.stringify(c)))
+    savedState = JSON.stringify(body.state ?? {})
+    if (!conversations.length) {
+      const legacy = legacyConversations()
+      const uploaded = await Promise.all(
+        legacy.map((c) => post(`/${encodeURIComponent(c.id)}`, JSON.stringify(c)))
+      )
+      if (uploaded.every(Boolean)) {
+        legacy.forEach((c) => saved.set(c.id, JSON.stringify(c)))
+        localStorage.removeItem(LEGACY_KEY)
+        conversations = legacy
+      }
+    }
+    loaded = true
+    return { state: { ...(body.state ?? {}), conversations } as History<S>, version: 0 }
+  }
+
+  const save = (value: StorageValue<History<S>>) => {
+    if (!loaded) return
+    pending = value
+    timer ??= setTimeout(() => {
+      queue = queue.then(flush)
+    }, SAVE_DELAY_MS)
+  }
+
+  return { load, save }
+}
