+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * SharePoint and OneDrive picker: MSAL signs the user in (authorization code with PKCE, in a
+ * popup, no client secret) with the account type and read-only scopes the backend reports: a work
+ * or school account (Entra ID) for its OneDrive and SharePoint sites, or a personal Microsoft
+ * account for its own OneDrive; when the backend takes both, the user picks one first. The
+ * Microsoft browser then lets them choose files and folders. Each kind's token lives in memory
+ * for this page only and is reused until shortly before it expires; MSAL's cache is in memory too.
+ */
+
+import type { IPublicClientApplication } from '@azure/msal-browser'
+import { chooseAccount } from './account-choice'
+import { type Accounts, showOneDriveBrowser } from './onedrive-browser'
+import { originBlock, originsOf } from './origins'
+import { PickerError, type ConnectorPicker, type PickResult, type SignInBlock } from './types'
+
+const EXPIRY_MARGIN_MS = 5 * 60 * 1000
+const SIGN_IN_TIMEOUT_MS = 5 * 60 * 1000
+
+/** One kind of account that may sign in, and how */
+export interface SignInKind {
+  accounts: Accounts
+  label: string
+  /** What the account opens, e.g. "SharePoint and OneDrive" */
+  reaches: string
+  authority: string
+  scopes: string[]
+}
+
+export interface OneDriveConfig {
+  client_id: string
+  /** Work first; more than one and the user picks */
+  sign_ins: SignInKind[]
+  redirect_path: string
+  origins: string[]
+  /** File suffixes the backend imports, e.g. ".pdf" */
+  importable: string[]
+}
+
+const strings = (v: unknown): string[] =>
+  Array.isArray(v) ? v.filter((s): s is string => typeof s === 'string' && Boolean(s)) : []
+
+const LABELS: Record<Accounts, [string, string]> = {
+  work: ['Work or school account', 'SharePoint and OneDrive'],
+  personal: ['Personal Microsoft account', 'OneDrive'],
+}
+
+const signInKind = (v: unknown): SignInKind | null => {
+  if (typeof v !== 'object' || v === null) return null
+  const entry = v as Record<string, unknown>
+  const accounts: Accounts = entry.accounts === 'work' ? 'work' : 'personal'
+  const scopes = strings(entry.scopes)
+  if (typeof entry.authority !== 'string' || !entry.authority || scopes.length === 0) return null
+  const label = typeof entry.label === 'string' && entry.label ? entry.label : LABELS[accounts][0]
+  const reaches =
+    typeof entry.reaches === 'string' && entry.reaches ? entry.reaches : LABELS[accounts][1]
+  return { accounts, label, reaches, authority: entry.authority, scopes }
+}
+
+export const parseConfig = (config: Record<string, unknown>): OneDriveConfig => {
+  const { client_id, redirect_path } = config
+  // a backend without sign_ins reports its one kind at the top level
+  const listed = Array.isArray(config.sign_ins) ? config.sign_ins : [config]
+  const sign_ins = listed.map(signInKind)
+  if (
+    [client_id, redirect_path].some((v) => typeof v !== 'string' || !v) ||
+    sign_ins.length === 0 ||
+    sign_ins.some((k) => k === null)
+  ) {
+    throw new PickerError('OneDrive import is misconfigured on the server')
+  }
+  return {
+    client_id: client_id as string,
+    sign_ins: sign_ins as SignInKind[],
+    redirect_path: redirect_path as string,
+    origins: originsOf(config.origins),
+    importable: strings(config.importable),
+  }
+}
+
+const blockedAt = (config: Record<string, unknown>, origin: string): SignInBlock | null =>
+  originBlock('Microsoft', config.origins, origin)
+
+/** MSAL clients by client ID and authority: one per kind of account */
+const apps = new Map<string, Promise<IPublicClientApplication>>()
+
+const msal = (config: OneDriveConfig, kind: SignInKind): Promise<IPublicClientApplication> => {
+  const key = `${config.client_id} ${kind.authority}`
+  let ready = apps.get(key)
+  if (!ready) {
+    ready = import('@azure/msal-browser').then(
+      ({ createStandardPublicClientApplication, BrowserCacheLocation }) =>
+        createStandardPublicClientApplication({
+          auth: {
+            clientId: config.client_id,
+            authority: kind.authority,
+            redirectUri: `${window.location.origin}${config.redirect_path}`,
+          },
+          cache: { cacheLocation: BrowserCacheLocation.MemoryStorage },
+          // signing in with a second factor, or creating an account, can take minutes
+          system: { popupBridgeTimeout: SIGN_IN_TIMEOUT_MS },
+        })
+    )
+    apps.set(key, ready)
+    ready.catch(() => apps.delete(key))
+  }
+  return ready
+}
+
+interface CachedToken {
+  token: string
+  expiresAt: number
+}
+
+/** Tokens by client ID and authority, so a work and a personal sign-in each keep theirs */
+const cached = new Map<string, CachedToken>()
+const cacheKey = (config: OneDriveConfig, kind: SignInKind): string =>
+  `${config.client_id} ${kind.authority}`
+
+const errorCode = (error: unknown): string =>
+  typeof error === 'object' && error !== null && 'errorCode' in error
+    ? String((error as { errorCode: unknown }).errorCode)
+    : ''
+
+/** A Graph access token for the configured scopes: the cached one, or a new one from Microsoft's sign-in popup */
+const signIn = async (config: OneDriveConfig, kind: SignInKind): Promise<string | null> => {
+  const key = cacheKey(config, kind)
+  const hit = cached.get(key)
+  if (hit && hit.expiresAt - EXPIRY_MARGIN_MS > Date.now()) return hit.token
+  const client = await msal(config, kind).catch(() => {
+    throw new PickerError("Couldn't load Microsoft sign-in; check the connection and try again")
+  })
+  try {
+    // MSAL can't see the popup close (Microsoft's pages cut it off from this window), so it waits
+    // for SIGN_IN_TIMEOUT_MS; a new click replaces a sign-in window someone closed.
+    const result = await client.acquireTokenPopup({
+      scopes: kind.scopes,
+      prompt: 'select_account',
+      overrideInteractionInProgress: true,
+    })
+    if (!result.accessToken) throw new PickerError('Microsoft sign-in failed')
+    const expiresAt = result.expiresOn ? result.expiresOn.getTime() : Date.now() + 3600 * 1000
+    cached.set(key, { token: result.accessToken, expiresAt })
+    return result.accessToken
+  } catch (error) {
+    if (error instanceof PickerError) throw error
+    const code = errorCode(error)
+    if (
+      code === 'user_cancelled' ||
+      code === 'access_denied' ||
+      code === 'consent_required' ||
+      code === 'interaction_in_progress_cancelled' ||
+      code === 'timed_out'
+    )
+      return null
+    if (code === 'popup_window_error' || code === 'empty_window_error') {
+      throw new PickerError('Allow pop-ups for this site to sign in with Microsoft')
+    }
+    if (code === 'interaction_in_progress') {
+      throw new PickerError('Finish the Microsoft sign-in that is already open')
+    }
+    throw new PickerError('Microsoft sign-in failed; try again')
+  }
+}
+
+export const oneDrivePicker: ConnectorPicker = {
+  blockedAt,
+
+  async preload(config) {
+    const drive = parseConfig(config)
+    await Promise.all(drive.sign_ins.map((kind) => msal(drive, kind)))
+  },
+
+  async pick(config, { maxItems }): Promise<PickResult | null> {
+    const drive = parseConfig(config)
+    const blocked = blockedAt(config, window.location.origin)
+    if (blocked) throw new PickerError(`${blocked.reason} ${blocked.command}`)
+    const kind =
+      drive.sign_ins.length === 1 ? drive.sign_ins[0] : await chooseAccount(drive.sign_ins)
+    if (!kind) return null
+    const token = await signIn(drive, kind)
+    if (!token) return null
+    let browsed
+    try {
+      browsed = await showOneDriveBrowser({
+        token,
+        maxItems: Math.max(1, maxItems),
+        importable: drive.importable,
+        accounts: kind.accounts,
+      })
+    } catch (error) {
+      cached.delete(cacheKey(drive, kind))
+      throw error
+    }
+    if (!browsed || browsed.items.length === 0) return null
+    return { credential: token, items: browsed.items, suggestion: browsed.suggestion }
+  },
+
+  forget() {
+    cached.clear()
+  },
+}
+
+/** Test seam */
+export const resetOneDriveForTests = (): void => {
+  cached.clear()
+  apps.clear()
+}
