+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+'use client'
+
+import { useEffect, useState } from 'react'
+import { createDocumentsClient, type ConnectorInfo, type ConnectorList } from '@/adapters/api'
+import { useAuth } from '@/adapters/auth'
+import { getConnectorPicker } from '../connectors'
+
+let listing: Promise<ConnectorList> | null = null
+
+const listOnce = (authToken: string | undefined): Promise<ConnectorList> => {
+  listing ??= createDocumentsClient({ authToken })
+    .listConnectors()
+    .catch((): ConnectorList => ({ connectors: [], preview: false }))
+    .then((found) => {
+      if (!found.connectors.some((c) => c.configured)) listing = null
+      return found
+    })
+  return listing
+}
+
+/**
+ * The document stores to show in the Files tab: those the backend reports set up, plus (in
+ * the backend's development preview) the rest, which show disabled. Only stores this UI has
+ * a picker for. Set-up stores start loading their sign-in scripts right away, so a click can
+ * open the sign-in popup without the browser blocking it; not where sign-in can't work.
+ */
+export const useConnectors = (enabled: boolean): ConnectorInfo[] => {
+  const { idToken } = useAuth()
+  const [connectors, setConnectors] = useState<ConnectorInfo[]>([])
+
+  useEffect(() => {
+    if (!enabled) return
+    let live = true
+    listOnce(idToken).then(({ connectors: found, preview }) => {
+      const shown = found.filter((c) => (c.configured || preview) && getConnectorPicker(c.id))
+      for (const c of shown) {
+        const picker = getConnectorPicker(c.id)!
+        if (!c.configured || picker.blockedAt(c.config, window.location.origin)) continue
+        picker.preload(c.config).catch(() => undefined)
+      }
+      if (live) setConnectors(shown)
+    })
+    return () => {
+      live = false
+    }
+  }, [enabled, idToken])
+
+  return enabled ? connectors : []
+}
+
+/** Test seam */
+export const resetConnectorsForTests = (): void => {
+  listing = null
+}
