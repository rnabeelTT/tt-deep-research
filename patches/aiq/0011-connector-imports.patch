+
+const drive = { id: 'google-drive', name: 'Google Drive', configured: true, config: { a: 1 } }
+
+describe('useConnectors', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    mockPicker.blockedAt.mockReturnValue(null)
+    resetConnectorsForTests()
+  })
+
+  test('offers set-up stores this UI has a picker for, and preloads them', async () => {
+    mockList.mockResolvedValue({
+      connectors: [drive, { id: 'dropbox', name: 'Dropbox', configured: true, config: {} }],
+      preview: false,
+    })
+
+    const { result } = renderHook(() => useConnectors(true))
+
+    await waitFor(() => expect(result.current).toEqual([drive]))
+    expect(mockPicker.preload).toHaveBeenCalledWith(drive.config)
+  })
+
+  test('a store that is not set up is hidden', async () => {
+    mockList.mockResolvedValue({
+      connectors: [{ ...drive, configured: false, config: {} }],
+      preview: false,
+    })
+
+    const { result } = renderHook(() => useConnectors(true))
+
+    await waitFor(() => expect(mockList).toHaveBeenCalled())
+    expect(result.current).toEqual([])
+    expect(mockPicker.preload).not.toHaveBeenCalled()
+  })
+
+  test('in preview a store that is not set up is shown, without loading its scripts', async () => {
+    const off = { ...drive, configured: false, config: {} }
+    mockList.mockResolvedValue({ connectors: [off], preview: true })
+
+    const { result } = renderHook(() => useConnectors(true))
+
+    await waitFor(() => expect(result.current).toEqual([off]))
+    expect(mockPicker.preload).not.toHaveBeenCalled()
+  })
+
+  test("a store that can't sign in from this page is offered but its scripts aren't loaded", async () => {
+    mockList.mockResolvedValue({ connectors: [drive], preview: false })
+    mockPicker.blockedAt.mockReturnValue({ reason: 'open localhost' })
+
+    const { result } = renderHook(() => useConnectors(true))
+
+    await waitFor(() => expect(result.current).toEqual([drive]))
+    expect(mockPicker.blockedAt).toHaveBeenCalledWith(drive.config, window.location.origin)
+    expect(mockPicker.preload).not.toHaveBeenCalled()
+  })
+
+  test('nothing is asked when files are off', () => {
+    const { result } = renderHook(() => useConnectors(false))
+
+    expect(result.current).toEqual([])
+    expect(mockList).not.toHaveBeenCalled()
+  })
+})
