+
+import { describe, test, expect, vi } from 'vitest'
+import { render, screen, fireEvent, waitFor } from '@testing-library/react'
+import { AccountChoiceDialog, chooseAccount } from './account-choice'
+import type { SignInKind } from './onedrive'
+
+const WORK: SignInKind = {
+  accounts: 'work',
+  label: 'Work or school account',
+  reaches: 'SharePoint and OneDrive',
+  authority: 'https://login.microsoftonline.com/organizations',
+  scopes: ['Files.Read.All', 'Sites.Read.All'],
+}
+const PERSONAL: SignInKind = {
+  accounts: 'personal',
+  label: 'Personal Microsoft account',
+  reaches: 'OneDrive',
+  authority: 'https://login.microsoftonline.com/consumers',
+  scopes: ['Files.Read'],
+}
+
+describe('AccountChoiceDialog', () => {
+  test('offers each kind with what it opens, and returns the one clicked', () => {
+    const onDone = vi.fn()
+    render(<AccountChoiceDialog kinds={[WORK, PERSONAL]} onDone={onDone} />)
+
+    expect(screen.getByText('SharePoint and OneDrive')).toBeInTheDocument()
+    fireEvent.click(screen.getByRole('button', { name: /Personal Microsoft account/ }))
+    expect(onDone).toHaveBeenCalledWith(PERSONAL)
+  })
+
+  test('focuses the work account first', () => {
+    render(<AccountChoiceDialog kinds={[WORK, PERSONAL]} onDone={vi.fn()} />)
+    expect(screen.getByRole('button', { name: /Work or school account/ })).toHaveFocus()
+  })
+
+  test('Escape and Cancel close it with no choice', () => {
+    const onDone = vi.fn()
+    render(<AccountChoiceDialog kinds={[WORK, PERSONAL]} onDone={onDone} />)
+    fireEvent.keyDown(window, { key: 'Escape' })
+    fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
+    expect(onDone).toHaveBeenNthCalledWith(1, null)
+    expect(onDone).toHaveBeenNthCalledWith(2, null)
+  })
+})
+
+describe('chooseAccount', () => {
+  test('resolves with the choice and removes the dialog', async () => {
+    const choice = chooseAccount([WORK, PERSONAL])
+    fireEvent.click(await screen.findByRole('button', { name: /Work or school account/ }))
+    await expect(choice).resolves.toEqual(WORK)
+    await waitFor(() => expect(document.querySelector('[data-account-choice]')).toBeNull())
+  })
+})
