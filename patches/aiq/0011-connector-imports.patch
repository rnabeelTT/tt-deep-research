+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Which Microsoft account to sign in with, when the backend takes both kinds: a work or school
+ * account (SharePoint and OneDrive) or a personal one (OneDrive). Microsoft signs each in at its
+ * own authority with its own scopes, so the choice comes before the sign-in popup.
+ */
+
+'use client'
+
+import { type FC, useEffect, useId, useRef } from 'react'
+import { createRoot } from 'react-dom/client'
+import type { SignInKind } from './onedrive'
+
+export interface AccountChoiceProps {
+  kinds: SignInKind[]
+  onDone: (kind: SignInKind | null) => void
+}
+
+export const AccountChoiceDialog: FC<AccountChoiceProps> = ({ kinds, onDone }) => {
+  const ids = useId()
+  const first = useRef<HTMLButtonElement>(null)
+
+  useEffect(() => {
+    first.current?.focus()
+    const onKey = (e: KeyboardEvent) => e.key === 'Escape' && onDone(null)
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [onDone])
+
+  return (
+    <div
+      className="fixed inset-0 z-[1000] flex items-center justify-center bg-black/50 p-4"
+      onMouseDown={(e) => e.target === e.currentTarget && onDone(null)}
+    >
+      <div
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby={`${ids}-title`}
+        className="border-base bg-surface-raised text-primary flex w-full max-w-sm flex-col gap-3 rounded-lg border p-4 shadow-xl"
+      >
+        <h2 id={`${ids}-title`} className="text-base font-semibold">
+          Sign in to Microsoft with…
+        </h2>
+        {kinds.map((kind, i) => (
+          <button
+            key={kind.accounts}
+            ref={i === 0 ? first : undefined}
+            type="button"
+            className="border-base hover:bg-surface-sunken flex flex-col items-start rounded border px-3 py-2 text-left text-sm"
+            onClick={() => onDone(kind)}
+          >
+            <span className="font-medium">{kind.label}</span>
+            <span className="text-subtle">{kind.reaches}</span>
+          </button>
+        ))}
+        <div className="flex justify-end">
+          <button
+            type="button"
+            className="border-base rounded border px-3 py-1 text-sm"
+            onClick={() => onDone(null)}
+          >
+            Cancel
+          </button>
+        </div>
+      </div>
+    </div>
+  )
+}
+
+/** Ask which kind of account to sign in with; resolves with it, or null when the dialog is closed */
+export const chooseAccount = (kinds: SignInKind[]): Promise<SignInKind | null> =>
+  new Promise((resolve) => {
+    const host = document.createElement('div')
+    host.dataset.accountChoice = ''
+    document.body.appendChild(host)
+    const root = createRoot(host)
+    let done = false
+    const onDone = (kind: SignInKind | null) => {
+      if (done) return
+      done = true
+      queueMicrotask(() => {
+        root.unmount()
+        host.remove()
+      })
+      resolve(kind)
+    }
+    root.render(<AccountChoiceDialog kinds={kinds} onDone={onDone} />)
+  })
