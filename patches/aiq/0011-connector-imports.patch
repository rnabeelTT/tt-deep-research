@@ -0,0 +1,36 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Where sign-in works. Google's OAuth client and Microsoft's app registration accept sign-in
+ * only from the origins registered with them, and allow plain http only on localhost; the
+ * backend sends that list (the recipe's [connectors] origins) in each connector's config.
+ */
+
+import type { SignInBlock } from './types'
+
+export const originsOf = (origins: unknown): string[] =>
+  Array.isArray(origins)
+    ? origins.filter((o): o is string => typeof o === 'string' && Boolean(o))
+    : []
+
+/** Null when ORIGIN is registered; otherwise how to open the app so PROVIDER's sign-in works */
+export const originBlock = (
+  provider: string,
+  origins: unknown,
+  origin: string
+): SignInBlock | null => {
+  const registered = originsOf(origins)
+  if (registered.length === 0 || registered.includes(origin)) return null
+  let port = '3000'
+  try {
+    const url = new URL(registered[0])
+    port = url.port || (url.protocol === 'https:' ? '443' : '80')
+  } catch {
+    // keep the default
+  }
+  return {
+    reason: `${provider} sign-in needs this app opened at ${registered[0]}, on the machine running it or through an SSH port forward:`,
+    command: `ssh -L ${port}:localhost:${port} <user>@<host>`,
+  }
+}
