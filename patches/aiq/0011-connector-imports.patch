--- /dev/null
+++ b/frontends/ui/src/features/documents/connectors/lawmatics.ts
@@ -0,0 +1,185 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Lawmatics picker. Lawmatics apps have a client secret, so sign-in is split: a popup opens
+ * Lawmatics' consent page (authorization code with PKCE and a state check), the redirect page
+ * hands the code back over a BroadcastChannel, and the backend swaps it for an access token with
+ * the app's secret. The token lives in memory for this page only, until shortly before it
+ * expires. The matter browser lists through the backend, which calls Lawmatics' API.
+ */
+
+import { createDocumentsClient } from '@/adapters/api'
+import { showLawmaticsBrowser } from './lawmatics-browser'
+import { originBlock, originsOf } from './origins'
+import { PickerError, type ConnectorPicker, type PickResult, type SignInBlock } from './types'
+
+const EXPIRY_MARGIN_MS = 5 * 60 * 1000
+const SIGN_IN_TIMEOUT_MS = 5 * 60 * 1000
+const CHANNEL = 'lawmatics-oauth'
+
+export interface LawmaticsConfig {
+  client_id: string
+  authorize_url: string
+  scope: string
+  redirect_path: string
+  origins: string[]
+  importable: string[]
+}
+
+const strings = (v: unknown): string[] =>
+  Array.isArray(v) ? v.filter((s): s is string => typeof s === 'string' && Boolean(s)) : []
+
+export const parseConfig = (config: Record<string, unknown>): LawmaticsConfig => {
+  const { client_id, authorize_url, redirect_path, scope } = config
+  if (
+    [client_id, authorize_url, redirect_path].some((v) => typeof v !== 'string' || !v) ||
+    !String(authorize_url).startsWith('https://')
+  ) {
+    throw new PickerError('Lawmatics import is misconfigured on the server')
+  }
+  return {
+    client_id: client_id as string,
+    authorize_url: authorize_url as string,
+    scope: typeof scope === 'string' ? scope : '',
+    redirect_path: redirect_path as string,
+    origins: originsOf(config.origins),
+    importable: strings(config.importable),
+  }
+}
+
+const blockedAt = (config: Record<string, unknown>, origin: string): SignInBlock | null =>
+  originBlock('Lawmatics', config.origins, origin)
+
+const base64url = (bytes: Uint8Array): string =>
+  btoa(String.fromCharCode(...bytes))
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '')
+
+const randomString = (bytes = 32): string =>
+  base64url(crypto.getRandomValues(new Uint8Array(bytes)))
+
+const challengeFor = async (verifier: string): Promise<string> =>
+  base64url(
+    new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier)))
+  )
+
+let cached: { clientId: string; token: string; expiresAt: number } | null = null
+
+interface Returned {
+  code: string | null
+  state: string | null
+  error: string | null
+}
+
+/** The redirect page's answer for STATE, or null when it doesn't come (closed, timed out) */
+const awaitCode = (state: string): Promise<Returned | null> =>
+  new Promise((resolve) => {
+    const channel = new BroadcastChannel(CHANNEL)
+    const finish = (value: Returned | null) => {
+      clearTimeout(timer)
+      channel.close()
+      resolve(value)
+    }
+    // Lawmatics' page may cut the popup off from this window, so its closing can't be seen;
+    // a new click starts a new sign-in instead.
+    const timer = setTimeout(() => finish(null), SIGN_IN_TIMEOUT_MS)
+    channel.onmessage = (event: MessageEvent<Returned>) => {
+      if (event.data?.state === state) finish(event.data)
+    }
+  })
+
+/** An access token: the cached one, or a new one from Lawmatics' consent page and our backend */
+const signIn = async (config: LawmaticsConfig): Promise<string | null> => {
+  if (
+    cached &&
+    cached.clientId === config.client_id &&
+    cached.expiresAt - EXPIRY_MARGIN_MS > Date.now()
+  ) {
+    return cached.token
+  }
+  // Opened before any await, inside the click, or the browser blocks it
+  const popup = window.open('about:blank', 'lawmatics-sign-in', 'popup,width=520,height=720')
+  if (!popup) throw new PickerError('Allow pop-ups for this site to sign in with Lawmatics')
+
+  if (!crypto.subtle) {
+    popup.close()
+    throw new PickerError('Lawmatics sign-in needs the app opened at http://localhost:3000')
+  }
+  const verifier = randomString(48)
+  const state = randomString(16)
+  const redirectUri = `${window.location.origin}${config.redirect_path}`
+  const url = new URL(config.authorize_url)
+  url.searchParams.set('response_type', 'code')
+  url.searchParams.set('client_id', config.client_id)
+  url.searchParams.set('redirect_uri', redirectUri)
+  url.searchParams.set('state', state)
+  url.searchParams.set('code_challenge', await challengeFor(verifier))
+  url.searchParams.set('code_challenge_method', 'S256')
+  if (config.scope) url.searchParams.set('scope', config.scope)
+  const answer = awaitCode(state)
+  popup.location.href = url.toString()
+
+  const returned = await answer
+  if (!returned) return null
+  if (returned.error === 'access_denied') return null
+  if (returned.error || !returned.code) {
+    throw new PickerError(`Lawmatics sign-in failed${returned.error ? `: ${returned.error}` : ''}`)
+  }
+  let token
+  try {
+    token = await createDocumentsClient({}).connectorToken(
+      'lawmatics',
+      returned.code,
+      verifier,
+      redirectUri
+    )
+  } catch (error) {
+    throw new PickerError(error instanceof Error ? error.message : 'Lawmatics sign-in failed')
+  }
+  cached = {
+    clientId: config.client_id,
+    token: token.access_token,
+    expiresAt: Date.now() + token.expires_in * 1000,
+  }
+  return token.access_token
+}
+
+export const lawmaticsPicker: ConnectorPicker = {
+  blockedAt,
+
+  async preload() {
+    // Nothing to load: the browser is part of this app
+  },
+
+  async pick(config, { maxItems }): Promise<PickResult | null> {
+    const lm = parseConfig(config)
+    const blocked = blockedAt(config, window.location.origin)
+    if (blocked) throw new PickerError(`${blocked.reason} ${blocked.command}`)
+    const token = await signIn(lm)
+    if (!token) return null
+    let browsed
+    try {
+      browsed = await showLawmaticsBrowser({
+        token,
+        maxItems: Math.max(1, maxItems),
+        importable: lm.importable,
+      })
+    } catch (error) {
+      cached = null
+      throw error
+    }
+    if (!browsed || browsed.items.length === 0) return null
+    return { credential: token, items: browsed.items, suggestion: browsed.suggestion }
+  },
+
+  forget() {
+    cached = null
+  },
+}
+
+/** Test seam */
+export const resetLawmaticsForTests = (): void => {
+  cached = null
+}
