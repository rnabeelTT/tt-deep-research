+}
+
+/** BroadcastChannel stand-in: what the redirect page posts reaches every open channel */
+class FakeChannel {
+  static open: FakeChannel[] = []
+  onmessage: ((e: MessageEvent) => void) | null = null
+  constructor(readonly name: string) {
+    FakeChannel.open.push(this)
+  }
+  close() {
+    FakeChannel.open = FakeChannel.open.filter((c) => c !== this)
+  }
+  static post(data: unknown) {
+    for (const c of [...FakeChannel.open]) c.onmessage?.({ data } as MessageEvent)
+  }
+}
+
+let popup: { location: { href: string }; close: () => void }
+
+/** Open the picker, then answer as the redirect page would, with the state the app sent */
+const pickAndReturn = async (answer: (state: string) => Record<string, unknown>) => {
+  popup.location.href = 'about:blank'
+  const picking = lawmaticsPicker.pick(CONFIG, { maxItems: 5 })
+  await vi.waitFor(() => expect(popup.location.href).toContain('https://app.lawmatics.com'))
+  const sent = new URL(popup.location.href)
+  FakeChannel.post(answer(sent.searchParams.get('state') ?? ''))
+  return { result: await picking, sent }
+}
+
+describe('lawmaticsPicker', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    resetLawmaticsForTests()
+    FakeChannel.open = []
+    popup = { location: { href: 'about:blank' }, close: vi.fn() }
+    vi.stubGlobal('BroadcastChannel', FakeChannel)
+    vi.stubGlobal('crypto', webcrypto)
+    vi.spyOn(window, 'open').mockImplementation(() => popup as unknown as Window)
+    mockToken.mockResolvedValue({ access_token: 'lm-token', expires_in: 3600 })
+    mockBrowser.mockResolvedValue({
+      items: [{ id: 'matter:11', name: 'Smith v. Acme', sizeBytes: 0 }],
+      suggestion: { name: 'smith-v-acme', description: 'Lawmatics matter Smith v. Acme' },
+    })
+  })
+
+  afterEach(() => {
+    vi.unstubAllGlobals()
+    vi.restoreAllMocks()
+  })
+
+  test('signs in with code, PKCE and state, has the backend swap the code, then browses', async () => {
+    const { result, sent } = await pickAndReturn((state) => ({ code: 'the-code', state }))
+
+    expect(window.open).toHaveBeenCalledTimes(1)
+    expect(sent.searchParams.get('response_type')).toBe('code')
+    expect(sent.searchParams.get('client_id')).toBe('lm-client')
+    expect(sent.searchParams.get('redirect_uri')).toBe(
