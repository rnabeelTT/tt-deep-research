+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+import { describe, test, expect, vi } from 'vitest'
+import { render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { CollectionPicker, namedCollections } from './CollectionPicker'
+import type { CollectionInfo } from '@/adapters/api'
+
+vi.mock('@/adapters/auth', () => ({ useAuth: () => ({ idToken: undefined }) }))
+
+const info = (name: string, description = ''): CollectionInfo => ({
+  name,
+  description,
+  file_count: 1,
+  chunk_count: 1,
+  backend: 'qdrant',
+  metadata: {},
+})
+
+const BOARD = info('board-packs', 'Board meeting packs')
+
+const show = (value = 'library', onCreate = vi.fn(async () => undefined)) => {
+  const onChange = vi.fn()
+  render(
+    <CollectionPicker value={value} collections={[BOARD]} onChange={onChange} onCreate={onCreate} />
+  )
+  return { onChange, onCreate }
+}
+
+describe('CollectionPicker', () => {
+  test('lists the Default collection first, the named ones, and a way to make one', () => {
+    show()
+    const options = screen.getAllByRole('option').map((o) => o.textContent)
+    expect(options).toEqual(['Default collection', 'board-packs', '+ New collection…'])
+    expect(screen.getByText(/shared by all chats/)).toBeInTheDocument()
+  })
+
+  test('a named collection shows its description, and choosing one reports it', async () => {
+    const { onChange } = show('board-packs')
+    expect(screen.getByText('Board meeting packs')).toBeInTheDocument()
+    await userEvent.setup().selectOptions(screen.getByRole('combobox'), 'library')
+    expect(onChange).toHaveBeenCalledWith('library')
+  })
+
+  test('a new collection needs a valid, free name and a description', async () => {
+    const user = userEvent.setup()
+    const { onCreate, onChange } = show()
+    await user.selectOptions(screen.getByRole('combobox'), '+ New collection…')
+    const create = screen.getByRole('button', { name: 'Create' })
+    expect(create).toBeDisabled()
+
+    await user.type(screen.getByLabelText('Collection name'), 'board-packs')
+    expect(screen.getByRole('alert')).toHaveTextContent('A collection has this name')
+    await user.clear(screen.getByLabelText('Collection name'))
+    await user.type(screen.getByLabelText('Collection name'), 'Contracts')
+    await user.type(screen.getByLabelText('What the collection holds'), 'Signed leases')
+    await user.click(create)
+
+    expect(onCreate).toHaveBeenCalledWith('contracts', 'Signed leases')
+    expect(onChange).not.toHaveBeenCalled()
+    expect(screen.queryByLabelText('Collection name')).not.toBeInTheDocument()
+  })
+
+  test('a failed create says why and keeps the form', async () => {
+    const user = userEvent.setup()
+    show(
+      'library',
+      vi.fn(async () => Promise.reject(new Error('name taken on the server')))
+    )
+    await user.selectOptions(screen.getByRole('combobox'), '+ New collection…')
+    await user.type(screen.getByLabelText('Collection name'), 'contracts')
+    await user.type(screen.getByLabelText('What the collection holds'), 'Leases')
+    await user.click(screen.getByRole('button', { name: 'Create' }))
+
+    expect(await screen.findByRole('alert')).toHaveTextContent('name taken on the server')
+    expect(screen.getByLabelText('Collection name')).toBeInTheDocument()
+  })
+})
+
+describe('namedCollections', () => {
+  test('leaves out the Default collection and chats’ own, sorted by name', () => {
+    const all = [info('zeta'), info('library'), info('s_0123abcd'), info('alpha')]
+    expect(namedCollections(all).map((c) => c.name)).toEqual(['alpha', 'zeta'])
+  })
+})
