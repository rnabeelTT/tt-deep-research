@@ -0,0 +1,180 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * The slice of Microsoft Graph the Microsoft browser needs: the SharePoint sites a work account
+ * can open and their document libraries, a folder of a drive (the user's OneDrive or a library),
+ * search, and paging. Called from the browser with the user's own token; the backend sees only
+ * the picked IDs.
+ */
+
+import { PickerError } from './types'
+
+export const GRAPH = 'https://graph.microsoft.com/v1.0'
+const SELECT = 'id,name,size,folder,file,package,remoteItem,parentReference,lastModifiedDateTime'
+const PAGE = 100
+
+export interface DriveEntry {
+  id: string
+  name: string
+  size?: number
+  folder?: { childCount?: number }
+  file?: { mimeType?: string }
+  package?: { type?: string }
+  remoteItem?: unknown
+  parentReference?: { driveId?: string }
+  lastModifiedDateTime?: string
+}
+
+export interface Page<T> {
+  entries: T[]
+  /** Graph's link to the next page, if any */
+  next: string | null
+}
+
+export type DrivePage = Page<DriveEntry>
+
+export interface Site {
+  id: string
+  displayName?: string
+  name?: string
+  webUrl?: string
+}
+
+export interface Library {
+  id: string
+  name?: string
+}
+
+/** Graph refused the token (expired or revoked): sign in again */
+export class GraphAuthError extends PickerError {}
+
+const readPage = async <T extends { id: string }>(
+  url: string,
+  token: string,
+  signal?: AbortSignal,
+  missing = 'OneDrive refused the request (404)'
+): Promise<Page<T>> => {
+  if (!url.startsWith(`${GRAPH}/`)) throw new PickerError('Microsoft sent an unexpected link')
+  let response: Response
+  try {
+    response = await fetch(url, { headers: { Authorization: `Bearer ${token}` }, signal })
+  } catch (error) {
+    if ((error as Error)?.name === 'AbortError') throw error
+    throw new PickerError("Couldn't reach Microsoft; check the connection and try again")
+  }
+  if (response.status === 401) throw new GraphAuthError('Microsoft sign-in expired; sign in again')
+  if (response.status === 429 || response.status >= 500) {
+    throw new PickerError('Microsoft is busy; try again in a minute')
+  }
+  if (response.status === 404) throw new PickerError(missing)
+  if (!response.ok) throw new PickerError(`Microsoft refused the request (${response.status})`)
+  const body = (await response.json().catch(() => ({}))) as {
+    value?: unknown
+    '@odata.nextLink'?: unknown
+  }
+  const entries = (Array.isArray(body.value) ? body.value : []).filter(
+    (e): e is T => typeof e === 'object' && e !== null && typeof (e as T).id === 'string'
+  )
+  const next = typeof body['@odata.nextLink'] === 'string' ? body['@odata.nextLink'] : null
+  return { entries, next }
+}
+
+const ID = /^[A-Za-z0-9!_-]{1,128}$/
+const SITE_ID = /^[A-Za-z0-9.,_-]{1,300}$/
+const NO_ONEDRIVE = 'This account has no OneDrive; pick from a SharePoint site'
+
+/** A drive's base URL: DRIVE null is the user's own OneDrive */
+const driveUrl = (drive: string | null): string => {
+  if (drive === null) return `${GRAPH}/me/drive`
+  if (!ID.test(drive)) throw new PickerError('This library can’t be opened')
+  return `${GRAPH}/drives/${drive}`
+}
+
+/** A folder's children (FOLDER_ID null: the drive's root) */
+export const listFolder = (
+  token: string,
+  drive: string | null,
+  folderId: string | null,
+  signal?: AbortSignal
+): Promise<DrivePage> => {
+  const where = folderId ? `items/${encodeURIComponent(folderId)}` : 'root'
+  const query = `$select=${SELECT}&$top=${PAGE}&$orderby=name`
+  return readPage(`${driveUrl(drive)}/${where}/children?${query}`, token, signal, NO_ONEDRIVE)
+}
+
+/** Files and folders anywhere in a drive matching TEXT */
+export const searchDrive = (
+  token: string,
+  drive: string | null,
+  text: string,
+  signal?: AbortSignal
+): Promise<DrivePage> => {
+  const q = encodeURIComponent(text.replace(/'/g, "''"))
+  return readPage(
+    `${driveUrl(drive)}/root/search(q='${q}')?$select=${SELECT}&$top=${PAGE}`,
+    token,
+    signal,
+    NO_ONEDRIVE
+  )
+}
+
+/** People's own OneDrives are sites too; they're reached through My files, not listed */
+const personalSite = (site: Site): boolean => /-my\.sharepoint\.[a-z]+\//i.test(site.webUrl ?? '')
+
+/** SharePoint sites the user can open, matching TEXT (null: all of them) */
+export const listSites = async (
+  token: string,
+  text: string | null,
+  signal?: AbortSignal
+): Promise<Page<Site>> => {
+  const search = encodeURIComponent(text?.trim() || '*')
+  const page = await readPage<Site>(
+    `${GRAPH}/sites?search=${search}&$select=id,displayName,name,webUrl&$top=${PAGE}`,
+    token,
+    signal
+  )
+  return { ...page, entries: page.entries.filter((s) => SITE_ID.test(s.id) && !personalSite(s)) }
+}
+
+/** A site's document libraries */
+export const listLibraries = async (
+  token: string,
+  siteId: string,
+  signal?: AbortSignal
+): Promise<Page<Library>> => {
+  if (!SITE_ID.test(siteId)) throw new PickerError('This site can’t be opened')
+  const page = await readPage<Library>(
+    `${GRAPH}/sites/${siteId}/drives?$select=id,name,driveType`,
+    token,
+    signal,
+    'This site has no document libraries you can open'
+  )
+  return { ...page, entries: page.entries.filter((d) => ID.test(d.id)) }
+}
+
+export const nextPage = <T extends { id: string } = DriveEntry>(
+  token: string,
+  next: string,
+  signal?: AbortSignal
+): Promise<Page<T>> => readPage<T>(next, token, signal)
+
+/** The ID the backend takes for an entry: its drive ID and item ID */
+export const pickId = (entry: DriveEntry): string | null => {
+  const drive = entry.parentReference?.driveId
+  return drive && ID.test(drive) && ID.test(entry.id) ? `${drive}:${entry.id}` : null
+}
+
+const suffixOf = (name: string): string => {
+  const dot = name.lastIndexOf('.')
+  return dot > 0 ? name.slice(dot).toLowerCase() : ''
+}
+
+/** Why an entry can't be picked, or null when it can */
+export const unpickable = (entry: DriveEntry, importable: string[]): string | null => {
+  if (entry.remoteItem) return 'Shared items aren’t supported yet'
+  if (entry.package) return 'OneNote notebooks can’t be imported'
+  if (!pickId(entry)) return 'This item can’t be imported'
+  if (entry.folder) return null
+  return importable.includes(suffixOf(entry.name)) ? null : 'This file type can’t be imported'
+}
