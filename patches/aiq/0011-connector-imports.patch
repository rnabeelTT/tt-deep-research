+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+import { PickerError } from './types'
+
+const LOAD_TIMEOUT_MS = 20_000
+const loading = new Map<string, Promise<void>>()
+
+/**
+ * Load a third-party script once per page. A failed load is forgotten, so the next attempt
+ * (after the network recovers, or an ad blocker is paused) tries again.
+ */
+export const loadScript = (src: string): Promise<void> => {
+  const existing = loading.get(src)
+  if (existing) return existing
+
+  const promise = new Promise<void>((resolve, reject) => {
+    const script = document.createElement('script')
+    const timer = window.setTimeout(() => fail('timed out'), LOAD_TIMEOUT_MS)
+
+    function fail(why: string) {
+      window.clearTimeout(timer)
+      script.remove()
+      loading.delete(src)
+      reject(
+        new PickerError(
+          `Couldn't load ${new URL(src).host} (${why}); check your connection or browser extensions`
+        )
+      )
+    }
+
+    script.src = src
+    script.async = true
+    script.onload = () => {
+      window.clearTimeout(timer)
+      resolve()
+    }
+    script.onerror = () => fail('blocked or offline')
+    document.head.appendChild(script)
+  })
+
+  loading.set(src, promise)
+  return promise
+}
+
+/** Test seam: forget every load */
+export const resetScriptsForTests = (): void => {
+  loading.clear()
+}
