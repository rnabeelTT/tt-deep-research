+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * The Microsoft browser: a dialog over the app that lists files through Microsoft Graph, with
+ * folder navigation, search and multi-select of files and folders. Work accounts start at a home
+ * view of their OneDrive (My files) and the SharePoint sites they can open, then a site's document
+ * libraries; personal accounts start in their OneDrive. Only types the backend can import are
+ * selectable; a picked folder imports its files.
+ *
+ * Microsoft's own File Picker (v8) runs on a different host for personal and business
+ * accounts and needs a token per SharePoint resource; browsing Graph directly keeps one token
+ * and one code path.
+ */
+
+'use client'
+
+import { type FC, type ReactNode, useCallback, useEffect, useMemo, useRef, useState } from 'react'
+import { createRoot } from 'react-dom/client'
+import {
+  type DriveEntry,
+  GraphAuthError,
+  type Library,
+  listFolder,
+  listLibraries,
+  listSites,
+  nextPage,
+  pickId,
+  searchDrive,
+  type Site,
+  unpickable,
+} from './onedrive-graph'
+import type { CollectionSuggestion, PickedItem } from './types'
+
+export type Accounts = 'work' | 'personal'
+
+type Place =
+  | { kind: 'home'; name: string }
+  | { kind: 'site'; site: string; name: string }
+  | { kind: 'folder'; drive: string | null; folder: string | null; name: string }
+
+type Row =
+  | { kind: 'place'; key: string; name: string; icon: string; detail: string; to: Place }
+  | { kind: 'entry'; key: string; entry: DriveEntry }
+
+interface Listing {
+  rows: Row[]
+  /** Loads the next page, when there is one */
+  more: (() => Promise<Listing>) | null
+}
+
+export interface OneDriveBrowserProps {
+  token: string
+  maxItems: number
+  importable: string[]
+  /** Work accounts get SharePoint sites as well as their OneDrive */
+  accounts?: Accounts
+  /** The picks, and the collection suggested by the library they were picked in */
+  onDone: (items: PickedItem[] | null, error?: Error, suggestion?: CollectionSuggestion) => void
+}
+
+export interface Browsed {
+  items: PickedItem[]
+  suggestion?: CollectionSuggestion
+}
+
+/** A collection name from free text: lowercase letters, digits and -, up to 48 */
+export const collectionName = (text: string): string =>
+  text
+    .toLowerCase()
+    .normalize('NFKD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+/, '')
+    .slice(0, 48)
+    .replace(/-+$/, '')
+
+/** The SharePoint site and library the browser is in, as a collection to import into */
+const suggestFrom = (trail: Place[]): CollectionSuggestion | undefined => {
+  const site = trail.find((p) => p.kind === 'site')
+  const library = trail.find((p) => p.kind === 'folder' && p.drive !== null && p.folder === null)
+  if (!site || !library) return undefined
+  const name = collectionName(`${site.name} ${library.name}`)
+  if (!name) return undefined
+  return { name, description: `${site.name} site, ${library.name} library (SharePoint)` }
+}
+
+const MY_FILES: Place = { kind: 'folder', drive: null, folder: null, name: 'My files' }
+const HOME: Place = { kind: 'home', name: 'Home' }
+
+const formatSize = (bytes?: number): string => {
+  if (!bytes) return ''
+  const units = ['B', 'KB', 'MB', 'GB']
+  let n = bytes
+  let i = 0
+  while (n >= 1024 && i < units.length - 1) {
+    n /= 1024
+    i += 1
+  }
+  return `${n < 10 && i > 0 ? n.toFixed(1) : Math.round(n)} ${units[i]}`
+}
+
+const siteRow = (site: Site): Row => {
+  const name = site.displayName || site.name || 'Site'
+  const detail = site.webUrl ? new URL(site.webUrl).pathname.replace(/^\/sites\//, '') : ''
+  return {
+    kind: 'place',
+    key: `site:${site.id}`,
+    name,
+    icon: '🌐',
+    detail,
+    to: { kind: 'site', site: site.id, name },
+  }
+}
+
+const libraryRow = (library: Library): Row => {
+  const name = library.name || 'Documents'
+  return {
+    kind: 'place',
+    key: `library:${library.id}`,
+    name,
+    icon: '📚',
+    detail: 'Library',
+    to: { kind: 'folder', drive: library.id, folder: null, name },
+  }
+}
+
+const entryRows = (entries: DriveEntry[]): Row[] =>
+  [...entries]
+    .sort((a, b) => Number(Boolean(b.folder)) - Number(Boolean(a.folder)))
+    .map((entry) => ({ kind: 'entry', key: `entry:${entry.id}`, entry }))
+
+/** A listing of Graph pages, mapping each page to rows */
+const paged = async <T extends { id: string }>(
+  token: string,
+  first: Promise<{ entries: T[]; next: string | null }>,
+  toRows: (entries: T[]) => Row[]
+): Promise<Listing> => {
+  const page = await first
+  return {
+    rows: toRows(page.entries),
+    more: page.next ? () => paged(token, nextPage<T>(token, page.next as string), toRows) : null,
+  }
+}
+
+const load = async (
+  token: string,
+  place: Place,
+  searching: string | null,
+  signal: AbortSignal
+): Promise<Listing> => {
+  if (place.kind === 'home') {
+    const sites = await paged(token, listSites(token, searching, signal), (s) => s.map(siteRow))
+    if (searching) return sites
+    const myFiles: Row = {
+      kind: 'place',
+      key: 'my-files',
+      name: 'My files',
+      icon: '👤',
+      detail: 'OneDrive',
+      to: MY_FILES,
+    }
+    return { ...sites, rows: [myFiles, ...sites.rows] }
+  }
+  if (place.kind === 'site') {
+    const text = searching?.toLowerCase()
+    return paged(token, listLibraries(token, place.site, signal), (libraries) =>
+      libraries.filter((l) => !text || (l.name ?? '').toLowerCase().includes(text)).map(libraryRow)
+    )
+  }
+  const page = searching
+    ? searchDrive(token, place.drive, searching, signal)
+    : listFolder(token, place.drive, place.folder, signal)
+  return paged(token, page, entryRows)
+}
+
+const searchLabel = (place: Place): string => {
+  if (place.kind === 'home') return 'Search SharePoint sites'
+  if (place.kind === 'site') return 'Filter libraries'
+  return place.drive === null ? 'Search your OneDrive' : `Search ${place.name}`
+}
+
+export const OneDriveBrowser: FC<OneDriveBrowserProps> = ({
+  token,
+  maxItems,
+  importable,
