+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Which collection the Files tab shows, and where its uploads and imports go: the Default
+ * collection, a named one, or a new one made here (a name, and a description agents read to
+ * decide when to search it). Choosing a collection doesn't change what research searches; the
+ * Data Sources tab switches each collection on or off per chat.
+ */
+
+'use client'
+
+import { type FC, useCallback, useEffect, useId, useMemo, useState } from 'react'
+import { createDocumentsClient, type CollectionInfo } from '@/adapters/api'
+import { useAuth } from '@/adapters/auth'
+import { COLLECTION_NAME, MAX_DESCRIPTION } from '../connectors/import-target'
+import { DEFAULT_COLLECTION, DEFAULT_COLLECTION_LABEL } from '../constants'
+
+const NEW = '__new__'
+
+/** Named collections the user made: not the Default collection, not a chat's own */
+export const namedCollections = (all: CollectionInfo[]): CollectionInfo[] =>
+  all
+    .filter((c) => c.name !== DEFAULT_COLLECTION && !c.name.startsWith('s_'))
+    .sort((a, b) => a.name.localeCompare(b.name))
+
+/** The collections, listed again whenever `version` changes */
+export const useCollections = (version: unknown): CollectionInfo[] => {
+  const { idToken } = useAuth()
+  const [named, setNamed] = useState<CollectionInfo[]>([])
+  useEffect(() => {
+    let live = true
+    createDocumentsClient({ authToken: idToken })
+      .listCollections()
+      .then((all) => live && setNamed(namedCollections(all)))
+      .catch(() => undefined)
+    return () => {
+      live = false
+    }
+  }, [idToken, version])
+  return named
+}
+
+export interface NewCollectionFormProps {
+  taken: string[]
+  onCreate: (name: string, description: string) => Promise<void>
+  onCancel: () => void
+}
+
+export const NewCollectionForm: FC<NewCollectionFormProps> = ({ taken, onCreate, onCancel }) => {
+  const ids = useId()
+  const [name, setName] = useState('')
+  const [description, setDescription] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [failed, setFailed] = useState<string | null>(null)
+
+  const problem = useMemo(() => {
+    if (!name) return null
+    if (!COLLECTION_NAME.test(name)) return 'Names are lowercase letters, digits, - and _'
+    if (name === DEFAULT_COLLECTION || taken.includes(name)) return 'A collection has this name'
+    return null
+  }, [name, taken])
+  const ready = Boolean(name && description.trim() && !problem && !busy)
+
+  const submit = async () => {
+    if (!ready) return
+    setBusy(true)
+    setFailed(null)
+    try {
+      await onCreate(name, description.trim())
+    } catch (err) {
+      setFailed(err instanceof Error ? err.message : `Couldn't create ${name}`)
+      setBusy(false)
+    }
+  }
+
+  return (
+    <form
+      aria-labelledby={`${ids}-title`}
+      className="border-base flex flex-col gap-2 rounded border p-3 text-sm"
+      onSubmit={(e) => {
+        e.preventDefault()
+        void submit()
+      }}
+    >
+      <span id={`${ids}-title`} className="font-medium">
+        New collection
+      </span>
+      <input
+        aria-label="Collection name"
+        value={name}
+        maxLength={48}
+        autoFocus
+        onChange={(e) => setName(e.target.value.toLowerCase())}
+        placeholder="board-packs"
+        className="border-base bg-surface-base rounded border px-2 py-1 font-mono"
+      />
+      <textarea
+        aria-label="What the collection holds"
+        value={description}
+        maxLength={MAX_DESCRIPTION}
+        rows={2}
+        onChange={(e) => setDescription(e.target.value)}
+        placeholder="Board meeting packs, 2024–2026"
+        className="border-base bg-surface-base rounded border px-2 py-1"
+      />
+      <span className="text-subtle text-xs">
+        Research reads the description to decide when to search the collection.
+      </span>
+      {(problem || failed) && (
+        <p role="alert" className="text-error text-xs">
+          {problem || failed}
+        </p>
+      )}
+      <div className="flex justify-end gap-2">
+        <button type="button" className="border-base rounded border px-3 py-1" onClick={onCancel}>
+          Cancel
+        </button>
+        <button
+          type="submit"
+          className="rounded bg-[var(--color-brand)] px-3 py-1 font-medium text-white disabled:opacity-50"
+          disabled={!ready}
+        >
+          Create
+        </button>
+      </div>
+    </form>
+  )
+}
+
+export interface CollectionPickerProps {
+  value: string
+  collections: CollectionInfo[]
+  onChange: (name: string) => void
+  /** Make a collection on the server; the picker then switches to it */
+  onCreate: (name: string, description: string) => Promise<void>
+  disabled?: boolean
+}
+
+export const CollectionPicker: FC<CollectionPickerProps> = ({
+  value,
+  collections,
+  onChange,
+  onCreate,
+  disabled,
+}) => {
+  const ids = useId()
+  const [creating, setCreating] = useState(false)
+  const current = collections.find((c) => c.name === value)
+  const about =
+    value === DEFAULT_COLLECTION
+      ? 'Where files go unless you pick a collection; shared by all chats.'
+      : current?.description || ''
+
+  const create = useCallback(
+    async (name: string, description: string) => {
+      await onCreate(name, description)
+      setCreating(false)
+    },
+    [onCreate]
+  )
+
+  return (
+    <div className="flex flex-col gap-1">
+      <label htmlFor={`${ids}-collection`} className="text-subtle text-xs font-semibold uppercase">
+        Collection
+      </label>
+      <select
+        id={`${ids}-collection`}
+        value={creating ? NEW : value}
+        disabled={disabled}
+        onChange={(e) => {
+          if (e.target.value === NEW) {
+            setCreating(true)
+            return
+          }
+          setCreating(false)
+          onChange(e.target.value)
+        }}
+        className="border-base bg-surface-base text-primary rounded border px-2 py-1 text-sm"
+      >
+        <option value={DEFAULT_COLLECTION}>{DEFAULT_COLLECTION_LABEL}</option>
+        {collections.map((c) => (
+          <option key={c.name} value={c.name}>
+            {c.name}
+          </option>
+        ))}
+        <option value={NEW}>+ New collection…</option>
+      </select>
+      {creating ? (
+        <NewCollectionForm
+          taken={collections.map((c) => c.name)}
+          onCreate={create}
+          onCancel={() => setCreating(false)}
+        />
+      ) : (
+        about && <span className="text-subtle text-xs">{about}</span>
+      )}
+    </div>
+  )
+}
