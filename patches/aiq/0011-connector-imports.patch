+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Google Drive picker: Google Identity Services signs the user in for the drive.file scope
+ * (only the files they pick), then the Google Picker lets them choose files from My Drive or
+ * shared drives. The access token lives in memory for this page only and is reused until
+ * shortly before it expires; nothing is written to storage.
+ */
+
+import { loadScript } from './load-script'
+import { originBlock, originsOf } from './origins'
+import {
+  PickerError,
+  type ConnectorPicker,
+  type PickedItem,
+  type PickResult,
+  type SignInBlock,
+} from './types'
+
+const GIS_SRC = 'https://accounts.google.com/gsi/client'
+const GAPI_SRC = 'https://apis.google.com/js/api.js'
+const EXPIRY_MARGIN_MS = 5 * 60 * 1000
+const GAPI_LOAD_TIMEOUT_MS = 20_000
+
+const FOLDER = 'application/vnd.google-apps.folder'
+/** What the backend can read; folders are listed only so people can browse into them */
+export const PICKABLE_MIME_TYPES = [
+  FOLDER,
+  'application/pdf',
+  'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
+  'text/plain',
+  'text/markdown',
+  'text/x-markdown',
+  'text/csv',
+  'application/vnd.google-apps.document',
+  'application/vnd.google-apps.presentation',
+  'application/vnd.google-apps.spreadsheet',
+]
+
+export interface GoogleDriveConfig {
+  client_id: string
+  api_key: string
+  app_id: string
+  scope: string
+  /** The OAuth client's authorized JavaScript origins; Google refuses sign-in from any other */
+  origins: string[]
+}
+
+// ----------------------------------------------------------------------------
+// The slice of Google's browser APIs used here
+// ----------------------------------------------------------------------------
+
+interface TokenResponse {
+  access_token?: string
+  expires_in?: number | string
+  error?: string
+  error_description?: string
+}
+
+interface TokenClient {
+  requestAccessToken(overrides?: { prompt?: string }): void
+}
+
+interface GoogleOAuth2 {
+  initTokenClient(config: {
+    client_id: string
+    scope: string
+    callback: (response: TokenResponse) => void
+    error_callback?: (error: { type?: string; message?: string }) => void
+  }): TokenClient
+  hasGrantedAllScopes(response: TokenResponse, scope: string): boolean
+  revoke(token: string, done?: () => void): void
+}
+
+interface PickerDoc {
+  id: string
+  name?: string
+  sizeBytes?: number | string
+}
+
+interface PickerCallbackData {
+  action: string
+  docs?: PickerDoc[]
+}
+
+interface DocsView {
+  setIncludeFolders(on: boolean): DocsView
+  setSelectFolderEnabled(on: boolean): DocsView
+  setMimeTypes(types: string): DocsView
+  setMode(mode: string): DocsView
+  setEnableDrives(on: boolean): DocsView
+}
+
+interface PickerBuilder {
+  addView(view: DocsView): PickerBuilder
+  enableFeature(feature: string): PickerBuilder
+  setOAuthToken(token: string): PickerBuilder
+  setDeveloperKey(key: string): PickerBuilder
+  setAppId(appId: string): PickerBuilder
+  setOrigin(origin: string): PickerBuilder
+  setTitle(title: string): PickerBuilder
+  setMaxItems(n: number): PickerBuilder
+  setCallback(callback: (data: PickerCallbackData) => void): PickerBuilder
+  build(): { setVisible(visible: boolean): void; dispose?(): void }
+}
+
+interface GooglePicker {
+  DocsView: new (viewId?: string) => DocsView
+  PickerBuilder: new () => PickerBuilder
+  ViewId: { DOCS: string }
+  DocsViewMode: { LIST: string }
+  Feature: { MULTISELECT_ENABLED: string; SUPPORT_DRIVES: string }
+  Action: { PICKED: string; CANCEL: string }
+}
+
+interface GoogleGlobal {
+  accounts?: { oauth2?: GoogleOAuth2 }
+  picker?: GooglePicker
+}
+
+interface Gapi {
+  load(
+    api: string,
+    options: { callback: () => void; onerror: () => void; timeout: number; ontimeout: () => void }
+  ): void
+}
+
+declare global {
+  interface Window {
+    google?: GoogleGlobal
+    gapi?: Gapi
+  }
+}
+
+// ----------------------------------------------------------------------------
+
+export const parseConfig = (config: Record<string, unknown>): GoogleDriveConfig => {
+  const { client_id, api_key, app_id, scope, origins } = config
+  if ([client_id, api_key, app_id, scope].some((v) => typeof v !== 'string' || !v)) {
+    throw new PickerError('Google Drive import is misconfigured on the server')
+  }
+  return { ...(config as unknown as GoogleDriveConfig), origins: originsOf(origins) }
+}
+
+const blockedAt = (config: Record<string, unknown>, origin: string): SignInBlock | null =>
+  originBlock('Google', config.origins, origin)
+
+let pickerReady: Promise<void> | null = null
+
+const loadPickerApi = (): Promise<void> => {
+  pickerReady ??= loadScript(GAPI_SRC)
+    .then(
+      () =>
+        new Promise<void>((resolve, reject) => {
+          const failed = () => reject(new PickerError("Couldn't load the Google Picker"))
+          window.gapi!.load('picker', {
+            callback: resolve,
+            onerror: failed,
+            timeout: GAPI_LOAD_TIMEOUT_MS,
+            ontimeout: failed,
+          })
+        })
+    )
+    .catch((error) => {
+      pickerReady = null
+      throw error
+    })
+  return pickerReady
+}
+
+interface CachedToken {
+  clientId: string
+  token: string
+  expiresAt: number
+}
+
+let cached: CachedToken | null = null
+
+const freshToken = (clientId: string): string | null =>
+  cached && cached.clientId === clientId && cached.expiresAt - EXPIRY_MARGIN_MS > Date.now()
+    ? cached.token
+    : null
+
+/** A drive.file access token: the cached one, or a new one from Google's sign-in popup */
+const signIn = (config: GoogleDriveConfig): Promise<string | null> => {
+  const reuse = freshToken(config.client_id)
+  if (reuse) return Promise.resolve(reuse)
+
+  const oauth2 = window.google?.accounts?.oauth2
+  if (!oauth2) return Promise.reject(new PickerError('Google sign-in is still loading; try again'))
+
+  return new Promise((resolve, reject) => {
+    const client = oauth2.initTokenClient({
+      client_id: config.client_id,
+      scope: config.scope,
+      callback: (response) => {
+        if (response.error || !response.access_token) {
+          if (response.error === 'access_denied') return resolve(null)
+          return reject(new PickerError(response.error_description || 'Google sign-in failed'))
+        }
+        if (!oauth2.hasGrantedAllScopes(response, config.scope)) {
+          return reject(
+            new PickerError('Allow access to the files you pick to import from Google Drive')
+          )
+        }
+        const seconds = Number(response.expires_in) || 3600
+        cached = {
+          clientId: config.client_id,
+          token: response.access_token,
+          expiresAt: Date.now() + seconds * 1000,
+        }
+        resolve(response.access_token)
+      },
+      error_callback: (error) => {
+        if (error.type === 'popup_closed') return resolve(null)
+        if (error.type === 'popup_failed_to_open') {
+          return reject(new PickerError('Allow pop-ups for this site to sign in with Google'))
+        }
+        reject(new PickerError(error.message || 'Google sign-in failed'))
+      },
+    })
+    client.requestAccessToken({ prompt: cached ? '' : 'select_account' })
+  })
+}
+
+const showPicker = (
+  config: GoogleDriveConfig,
+  token: string,
+  maxItems: number
+): Promise<PickedItem[] | null> => {
+  const picker = window.google?.picker
+  if (!picker) return Promise.reject(new PickerError("Couldn't load the Google Picker"))
+
+  const mimeTypes = PICKABLE_MIME_TYPES.join(',')
+  const myDrive = new picker.DocsView(picker.ViewId.DOCS)
+    .setIncludeFolders(true)
+    .setSelectFolderEnabled(false)
+    .setMimeTypes(mimeTypes)
+    .setMode(picker.DocsViewMode.LIST)
+  const sharedDrives = new picker.DocsView(picker.ViewId.DOCS)
+    .setEnableDrives(true)
+    .setIncludeFolders(true)
+    .setSelectFolderEnabled(false)
+    .setMimeTypes(mimeTypes)
+    .setMode(picker.DocsViewMode.LIST)
+
+  return new Promise((resolve) => {
+    const built = new picker.PickerBuilder()
+      .addView(myDrive)
+      .addView(sharedDrives)
+      .enableFeature(picker.Feature.MULTISELECT_ENABLED)
+      .enableFeature(picker.Feature.SUPPORT_DRIVES)
+      .setOAuthToken(token)
+      .setDeveloperKey(config.api_key)
+      .setAppId(config.app_id)
+      .setOrigin(`${window.location.protocol}//${window.location.host}`)
+      .setTitle('Choose files to import')
+      .setMaxItems(Math.max(1, maxItems))
+      .setCallback((data) => {
+        if (data.action === picker.Action.PICKED) {
+          built.dispose?.()
+          resolve(
+            (data.docs ?? []).map((doc) => ({
+              id: doc.id,
+              name: doc.name || 'Untitled',
+              sizeBytes: Number(doc.sizeBytes) || 0,
+            }))
+          )
+        } else if (data.action === picker.Action.CANCEL) {
+          built.dispose?.()
+          resolve(null)
+        }
+      })
+      .build()
+    built.setVisible(true)
+  })
+}
+
+export const googleDrivePicker: ConnectorPicker = {
+  blockedAt,
+
+  async preload(config) {
+    parseConfig(config)
+    await Promise.all([loadScript(GIS_SRC), loadPickerApi()])
+  },
+
+  async pick(config, { maxItems }): Promise<PickResult | null> {
+    const drive = parseConfig(config)
+    const blocked = blockedAt(config, window.location.origin)
+    if (blocked) throw new PickerError(`${blocked.reason} ${blocked.command}`)
+    await Promise.all([loadScript(GIS_SRC), loadPickerApi()])
+    const token = await signIn(drive)
+    if (!token) return null
+    const items = await showPicker(drive, token, maxItems)
+    if (!items || items.length === 0) return null
+    return { credential: token, items }
+  },
+
+  forget() {
+    cached = null
+  },
+}
+
+/** Test seam */
+export const resetGoogleDriveForTests = (): void => {
+  cached = null
+  pickerReady = null
+}
