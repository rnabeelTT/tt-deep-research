--- /dev/null
+++ b/frontends/ui/src/adapters/api/documents-client.connectors.spec.ts
@@ -0,0 +1,95 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+import { describe, test, expect, vi, beforeEach } from 'vitest'
+import { createDocumentsClient, ImportError, readBackendDetail } from './documents-client'
+
+vi.mock('./config', () => ({
+  apiConfig: { collectionsUrl: '/api/v1/collections', documentsBaseUrl: '/api/v1' },
+}))
+
+const json = (status: number, body: unknown) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } })
+
+describe('connector API', () => {
+  let mockFetch: ReturnType<typeof vi.fn>
+
+  beforeEach(() => {
+    mockFetch = vi.fn()
+    global.fetch = mockFetch as typeof fetch
+  })
+
+  test('lists the known connectors, whether each is set up, and the preview switch', async () => {
+    const drive = { id: 'google-drive', name: 'Google Drive', configured: false, config: {} }
+    const older = { id: 'onedrive', name: 'OneDrive', config: { client_id: 'c' } }
+    mockFetch.mockResolvedValue(json(200, { connectors: [drive, older], preview: true }))
+
+    await expect(createDocumentsClient().listConnectors()).resolves.toEqual({
+      connectors: [drive, { ...older, configured: true }],
+      preview: true,
+    })
+    expect(mockFetch.mock.calls[0][0]).toBe('/api/v1/connectors')
+  })
+
+  test('a backend without connectors offers none instead of failing', async () => {
+    const none = { connectors: [], preview: false }
+    mockFetch.mockResolvedValueOnce(json(404, { detail: 'Not Found' }))
+    await expect(createDocumentsClient().listConnectors()).resolves.toEqual(none)
+    mockFetch.mockResolvedValueOnce(json(200, { unexpected: true }))
+    await expect(createDocumentsClient().listConnectors()).resolves.toEqual(none)
+  })
+
+  test('imports picked items with the credential in the body only', async () => {
+    const reply = {
+      job_id: 'job-1',
+      file_ids: ['f1'],
+      files: [{ file_id: 'f1', file_name: 'Memo.pdf', status: 'ingesting', error_message: null }],
+      message: 'importing',
+    }
+    mockFetch.mockResolvedValue(json(200, reply))
+
+    const result = await createDocumentsClient().importItems(
+      's_chat',
+      'google-drive',
+      'ya29.token',
+      ['abc1234567']
+    )
+
+    expect(result.files[0].file_name).toBe('Memo.pdf')
+    const [url, init] = mockFetch.mock.calls[0]
+    expect(url).toBe('/api/v1/collections/s_chat/import/google-drive')
+    expect(url).not.toContain('ya29')
+    expect(init.method).toBe('POST')
+    expect(JSON.parse(init.body)).toEqual({ credential: 'ya29.token', item_ids: ['abc1234567'] })
+  })
+
+  test('a refused import carries the backend reason and status', async () => {
+    const wrapped = {
+      error: {
+        code: 'BACKEND_ERROR',
+        message: 'Backend returned 401: {"detail":"Google sign-in expired; sign in again"}',
+      },
+    }
+    mockFetch.mockResolvedValue(json(401, wrapped))
+
+    const failure = createDocumentsClient().importItems('s_chat', 'google-drive', 't', ['a'])
+    await expect(failure).rejects.toBeInstanceOf(ImportError)
+    await expect(failure).rejects.toMatchObject({
+      status: 401,
+      message: 'Google sign-in expired; sign in again',
+    })
+  })
+
+  test('backend details are unwrapped, and odd bodies fall back', async () => {
+    await expect(readBackendDetail(json(400, { detail: 'no files picked' }), 'x')).resolves.toBe(
+      'no files picked'
+    )
+    const garbled = json(500, { error: { message: 'Backend returned 500: <html>' } })
+    await expect(readBackendDetail(garbled, 'Import failed (500)')).resolves.toBe(
+      'Import failed (500)'
+    )
+    await expect(
+      readBackendDetail(new Response('nope', { status: 502 }), 'fallback')
+    ).resolves.toBe('fallback')
+  })
+})
