+++ b/frontends/ui/src/features/documents/connectors/import-target.tsx
@@ -0,0 +1,246 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Where picked files go: the Default collection, a collection that exists, or a new one. It starts
+ * on the collection the Files tab shows; a pick from a SharePoint library suggests a new collection
+ * named and described after the site and library instead. The description is what agents read to
+ * decide when to search it.
+ */
+
+'use client'
+
+import { type FC, useEffect, useId, useMemo, useRef, useState } from 'react'
+import { createRoot } from 'react-dom/client'
+import type { CollectionSuggestion } from './types'
+import { DEFAULT_COLLECTION_LABEL } from '../constants'
+
+/** Collection names the backend takes */
+export const COLLECTION_NAME = /^[a-z0-9][a-z0-9_-]{0,47}$/
+export const MAX_DESCRIPTION = 500
+
+export type ImportTarget =
+  | { kind: 'default' }
+  | { kind: 'collection'; name: string; create: false }
+  | { kind: 'collection'; name: string; create: true; description: string }
+
+export interface CollectionChoice {
+  name: string
+  description?: string | null
+}
+
+export interface ImportTargetProps {
+  count: number
+  store: string
+  /** Named collections that exist (not the Default collection) */
+  collections: CollectionChoice[]
+  /** The collection the Files tab shows; the dialog starts on it */
+  current?: string
+  suggestion?: CollectionSuggestion
+  onDone: (target: ImportTarget | null) => void
+}
+
+type Choice = 'default' | 'existing' | 'new'
+
+export const ImportTargetDialog: FC<ImportTargetProps> = ({
+  count,
+  store,
+  collections,
+  current,
+  suggestion,
+  onDone,
+}) => {
+  const ids = useId()
+  const suggestedExists = collections.some((c) => c.name === suggestion?.name)
+  const viewingNamed = collections.some((c) => c.name === current)
+  const [choice, setChoice] = useState<Choice>(
+    suggestion ? (suggestedExists ? 'existing' : 'new') : viewingNamed ? 'existing' : 'default'
+  )
+  const [existing, setExisting] = useState(
+    suggestedExists
+      ? (suggestion?.name ?? '')
+      : viewingNamed
+        ? (current ?? '')
+        : (collections[0]?.name ?? '')
+  )
+  const [name, setName] = useState(suggestedExists ? '' : (suggestion?.name ?? ''))
+  const [description, setDescription] = useState(
+    suggestedExists ? '' : (suggestion?.description ?? `Files from ${store}`)
+  )
+  const first = useRef<HTMLInputElement>(null)
+
+  useEffect(() => {
+    first.current?.focus()
+    const onKey = (e: KeyboardEvent) => e.key === 'Escape' && onDone(null)
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [onDone])
+
+  const taken = collections.some((c) => c.name === name)
+  const problem = useMemo(() => {
+    if (choice === 'existing' && !existing) return 'Choose a collection'
+    if (choice !== 'new') return null
+    if (!COLLECTION_NAME.test(name)) return 'Names are lowercase letters, digits, - and _'
+    if (taken) return 'A collection has this name; choose it above'
+    if (!description.trim())
+      return 'Say what the collection holds, so research knows when to use it'
+    return null
+  }, [choice, existing, name, taken, description])
+
+  const submit = () => {
+    if (problem) return
+    if (choice === 'default') onDone({ kind: 'default' })
+    else if (choice === 'existing') onDone({ kind: 'collection', name: existing, create: false })
+    else onDone({ kind: 'collection', name, create: true, description: description.trim() })
+  }
+
+  const files = count === 1 ? '1 item' : `${count} items`
+
+  return (
+    <div
+      className="fixed inset-0 z-[1000] flex items-center justify-center bg-black/50 p-4"
+      onMouseDown={(e) => e.target === e.currentTarget && onDone(null)}
+    >
+      <form
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby={`${ids}-title`}
+        className="border-base bg-surface-raised text-primary flex w-full max-w-lg flex-col gap-3 rounded-lg border p-4 shadow-xl"
+        onSubmit={(e) => {
+          e.preventDefault()
+          submit()
+        }}
+      >
+        <h2 id={`${ids}-title`} className="text-base font-semibold">
+          Import {files} from {store} into…
+        </h2>
+
+        <label className="flex items-start gap-2 text-sm">
+          <input
+            ref={choice === 'default' ? first : undefined}
+            type="radio"
+            name={`${ids}-target`}
+            checked={choice === 'default'}
+            onChange={() => setChoice('default')}
+          />
+          <span>
+            <span className="font-medium">{DEFAULT_COLLECTION_LABEL}</span>
+            <span className="text-subtle block">
+              Where files go unless you pick a collection; shared by all chats.
+            </span>
+          </span>
+        </label>
+
+        {collections.length > 0 && (
+          <label className="flex items-start gap-2 text-sm">
+            <input
+              ref={choice === 'existing' ? first : undefined}
+              type="radio"
+              name={`${ids}-target`}
+              checked={choice === 'existing'}
+              onChange={() => setChoice('existing')}
+            />
+            <span className="flex flex-1 flex-col gap-1">
+              <span className="font-medium">A collection</span>
+              <select
+                aria-label="Collection"
+                value={existing}
+                onChange={(e) => {
+                  setExisting(e.target.value)
+                  setChoice('existing')
+                }}
+                className="border-base bg-surface-base rounded border px-2 py-1"
+              >
+                {collections.map((c) => (
+                  <option key={c.name} value={c.name}>
+                    {c.name}
+                    {c.description ? ` — ${c.description}` : ''}
+                  </option>
+                ))}
+              </select>
+            </span>
+          </label>
+        )}
+
+        <label className="flex items-start gap-2 text-sm">
+          <input
+            ref={choice === 'new' ? first : undefined}
+            type="radio"
+            name={`${ids}-target`}
+            checked={choice === 'new'}
+            onChange={() => setChoice('new')}
+          />
+          <span className="font-medium">A new collection</span>
+        </label>
+        {choice === 'new' && (
+          <div className="flex flex-col gap-2 pl-6 text-sm">
+            <input
+              aria-label="Collection name"
+              value={name}
+              maxLength={48}
+              onChange={(e) => setName(e.target.value.toLowerCase())}
+              placeholder="board-packs"
+              className="border-base bg-surface-base rounded border px-2 py-1 font-mono"
+            />
+            <textarea
+              aria-label="What the collection holds"
+              value={description}
+              maxLength={MAX_DESCRIPTION}
+              rows={2}
+              onChange={(e) => setDescription(e.target.value)}
+              className="border-base bg-surface-base rounded border px-2 py-1"
+            />
+            <span className="text-subtle text-xs">
+              Research reads this to decide when to search the collection.
+            </span>
+          </div>
+        )}
+
+        {problem && (
+          <p role="alert" className="text-error text-sm">
+            {problem}
+          </p>
+        )}
+
+        <div className="flex justify-end gap-2">
+          <button
+            type="button"
+            className="border-base rounded border px-3 py-1 text-sm"
+            onClick={() => onDone(null)}
+          >
+            Cancel
+          </button>
+          <button
+            type="submit"
+            className="rounded bg-[var(--color-brand)] px-3 py-1 text-sm font-medium text-white disabled:opacity-50"
+            disabled={Boolean(problem)}
+          >
+            Import
+          </button>
+        </div>
+      </form>
+    </div>
+  )
+}
+
+/** Ask where picked files go; resolves with the target, or null when the dialog is closed */
+export const chooseImportTarget = (
+  props: Omit<ImportTargetProps, 'onDone'>
+): Promise<ImportTarget | null> =>
+  new Promise((resolve) => {
+    const host = document.createElement('div')
+    host.dataset.importTarget = ''
+    document.body.appendChild(host)
+    const root = createRoot(host)
+    let done = false
+    const onDone = (target: ImportTarget | null) => {
+      if (done) return
+      done = true
+      queueMicrotask(() => {
+        root.unmount()
+        host.remove()
+      })
+      resolve(target)
+    }
+    root.render(<ImportTargetDialog {...props} onDone={onDone} />)
+  })
