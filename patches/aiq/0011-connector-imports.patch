+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+import { describe, test, expect, vi } from 'vitest'
+import { render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { ImportTargetDialog } from './import-target'
+import { collectionName } from './onedrive-browser'
+
+const show = (props: Partial<Parameters<typeof ImportTargetDialog>[0]> = {}) => {
+  const onDone = vi.fn()
+  render(
+    <ImportTargetDialog
+      count={3}
+      store="SharePoint and OneDrive"
+      collections={[{ name: 'board-packs', description: 'Board packs' }]}
+      onDone={onDone}
+      {...props}
+    />
+  )
+  return onDone
+}
+
+describe('ImportTargetDialog', () => {
+  test('without a suggestion, files go to the Default collection', async () => {
+    const onDone = show({ current: 'library' })
+    expect(
+      screen.getByText('Import 3 items from SharePoint and OneDrive into…')
+    ).toBeInTheDocument()
+    expect(screen.getByRole('radio', { name: /Default collection/ })).toBeChecked()
+    await userEvent.setup().click(screen.getByRole('button', { name: 'Import' }))
+    expect(onDone).toHaveBeenCalledWith({ kind: 'default' })
+  })
+
+  test('starts on the named collection the Files tab shows', async () => {
+    const onDone = show({ current: 'board-packs' })
+    await userEvent.setup().click(screen.getByRole('button', { name: 'Import' }))
+    expect(onDone).toHaveBeenCalledWith({ kind: 'collection', name: 'board-packs', create: false })
+  })
+
+  test('a SharePoint library suggests a new collection named and described after it', async () => {
+    const onDone = show({
+      suggestion: { name: 'finance-documents', description: 'Finance site, Documents library' },
+    })
+    expect(screen.getByLabelText('Collection name')).toHaveValue('finance-documents')
+    await userEvent.setup().click(screen.getByRole('button', { name: 'Import' }))
+    expect(onDone).toHaveBeenCalledWith({
+      kind: 'collection',
+      name: 'finance-documents',
+      create: true,
+      description: 'Finance site, Documents library',
+    })
+  })
+
+  test('a suggestion that exists already picks that collection', async () => {
+    const onDone = show({ suggestion: { name: 'board-packs', description: 'x' } })
+    await userEvent.setup().click(screen.getByRole('button', { name: 'Import' }))
+    expect(onDone).toHaveBeenCalledWith({ kind: 'collection', name: 'board-packs', create: false })
+  })
+
+  test('a new collection needs a valid, free name and a description', async () => {
+    const user = userEvent.setup()
+    const onDone = show()
+    await user.click(screen.getByLabelText(/A new collection/))
+    const name = screen.getByLabelText('Collection name')
+    await user.type(name, 'Bad name')
+    expect(screen.getByRole('alert')).toHaveTextContent('lowercase letters')
+    await user.clear(name)
+    await user.type(name, 'board-packs')
+    expect(screen.getByRole('alert')).toHaveTextContent('choose it above')
+    await user.clear(name)
+    await user.type(name, 'q3')
+    await user.clear(screen.getByLabelText('What the collection holds'))
+    expect(screen.getByRole('button', { name: 'Import' })).toBeDisabled()
+    await user.type(screen.getByLabelText('What the collection holds'), 'Q3 close')
+    await user.click(screen.getByRole('button', { name: 'Import' }))
+    expect(onDone).toHaveBeenCalledWith({
+      kind: 'collection',
+      name: 'q3',
+      create: true,
+      description: 'Q3 close',
+    })
+  })
+
+  test('cancel and Escape close without a target', async () => {
+    const user = userEvent.setup()
+    const onDone = show()
+    await user.click(screen.getByRole('button', { name: 'Cancel' }))
+    await user.keyboard('{Escape}')
+    expect(onDone).toHaveBeenCalledWith(null)
+  })
+})
+
+describe('collectionName', () => {
+  test('makes a collection name from a site and library', () => {
+    expect(collectionName('Finance & Ops Documents')).toBe('finance-ops-documents')
+    expect(collectionName('Équipe Réseau')).toBe('equipe-reseau')
+    expect(collectionName('---')).toBe('')
+    expect(collectionName('x'.repeat(60))).toHaveLength(48)
+  })
+})
diff --git a/frontends/ui/src/features/documents/connectors/import-target.tsx b/frontends/ui/src/features/documents/connectors/import-target.tsx
