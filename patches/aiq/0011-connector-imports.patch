+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+import { describe, test, expect, vi } from 'vitest'
+import { render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { ImportError } from '@/adapters/api'
+import { LawmaticsBrowser, suggestFor } from './lawmatics-browser'
+
+const MATTERS = [
+  { id: '11', name: 'Smith v. Acme', status: 'hired' },
+  { id: '12', name: 'Estate of Ortiz', status: '' },
+]
+const FILES = [
+  { id: '101', name: 'Engagement letter.pdf', size: 2048, importable: true },
+  { id: '103', name: 'Photo.jpg', size: 50, importable: false },
+]
+
+const backend = () =>
+  vi.fn(async (request: Record<string, unknown>) => {
+    if (request.kind === 'matters') {
+      const q = String(request.query ?? '').toLowerCase()
+      return { matters: MATTERS.filter((m) => m.name.toLowerCase().includes(q)), more: false }
+    }
+    return { files: FILES, more: false }
+  }) as unknown as <T>(request: Record<string, unknown>) => Promise<T>
+
+const show = (browse = backend(), maxItems = 10) => {
+  const onDone = vi.fn()
+  render(
+    <LawmaticsBrowser
+      token="lm-token"
+      maxItems={maxItems}
+      importable={['.pdf']}
+      onDone={onDone}
+      browse={browse}
+    />
+  )
+  return { onDone, browse }
+}
+
+describe('LawmaticsBrowser', () => {
+  test('lists matters, opens one, and imports picked files with a suggestion after it', async () => {
+    const user = userEvent.setup()
+    const { onDone } = show()
+
+    await user.click(await screen.findByRole('button', { name: 'Smith v. Acme' }))
+    expect(await screen.findByText('Engagement letter.pdf')).toBeInTheDocument()
+    expect(screen.getByLabelText('Select Photo.jpg')).toBeDisabled()
+    await user.click(screen.getByLabelText('Select Engagement letter.pdf'))
+    await user.click(screen.getByRole('button', { name: 'Import' }))
+
+    expect(onDone).toHaveBeenCalledWith(
+      [{ id: 'file:101', name: 'Engagement letter.pdf', sizeBytes: 2048 }],
+      undefined,
+      { name: 'smith-v-acme', description: 'Lawmatics matter Smith v. Acme' }
+    )
+  })
+
+  test('a whole matter can be picked from the list', async () => {
+    const user = userEvent.setup()
+    const { onDone } = show()
+    await user.click(await screen.findByLabelText('Select all files of Estate of Ortiz'))
+    await user.click(screen.getByRole('button', { name: 'Import' }))
+    expect(onDone.mock.calls[0][0]).toEqual([
+      { id: 'matter:12', name: 'Estate of Ortiz', sizeBytes: 0 },
+    ])
+  })
+
+  test('searching asks the backend for matching matters', async () => {
+    const user = userEvent.setup()
+    const { browse } = show()
+    await screen.findByText('Smith v. Acme')
+    await user.type(screen.getByRole('searchbox', { name: 'Search matters' }), 'ortiz{Enter}')
+    expect(await screen.findByText('Matters matching “ortiz”')).toBeInTheDocument()
+    expect(browse).toHaveBeenLastCalledWith({ kind: 'matters', query: 'ortiz', page: 1 })
+    expect(screen.queryByText('Smith v. Acme')).not.toBeInTheDocument()
+  })
+
+  test('picks stop at the import limit', async () => {
+    const user = userEvent.setup()
+    show(backend(), 1)
+    await user.click(await screen.findByLabelText('Select all files of Smith v. Acme'))
+    expect(screen.getByLabelText('Select all files of Estate of Ortiz')).toBeDisabled()
+    expect(screen.getByText(/the most for one import/)).toBeInTheDocument()
+  })
+
+  test('an expired sign-in closes the browser with the reason', async () => {
+    const browse = vi.fn(async () => {
+      throw new ImportError('Lawmatics sign-in expired; sign in again', 401)
+    }) as unknown as <T>(request: Record<string, unknown>) => Promise<T>
+    const { onDone } = show(browse)
+    await vi.waitFor(() => expect(onDone).toHaveBeenCalled())
+    expect(onDone.mock.calls[0][1].message).toMatch(/sign-in expired/)
+  })
+})
+
+describe('suggestFor', () => {
+  test('only picks from one matter suggest a collection', () => {
+    expect(suggestFor(new Set(['Smith v. Acme']))?.name).toBe('smith-v-acme')
+    expect(suggestFor(new Set(['A', 'B']))).toBeUndefined()
+    expect(suggestFor(new Set())).toBeUndefined()
+  })
+})
