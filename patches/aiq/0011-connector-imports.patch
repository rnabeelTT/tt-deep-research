diff --git a/frontends/ui/src/features/layout/components/ConnectorImportButtons.tsx b/frontends/ui/src/features/layout/components/ConnectorImportButtons.tsx
new file mode 100644
index 0000000..d946cba
--- /dev/null
+++ b/frontends/ui/src/features/layout/components/ConnectorImportButtons.tsx
@@ -0,0 +1,130 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * One button per document store (Google Drive, OneDrive, ...): opens the store's sign-in and
+ * picker, then imports the picked files into this chat's documents. A store whose sign-in can't
+ * work from this page (sign-in only accepts localhost), or that isn't set up (shown only in the
+ * backend's development preview), shows its button disabled, and ConnectorSignInNotes says why.
+ */
+
+'use client'
+
+import { type FC, useCallback, useMemo, useRef, useState } from 'react'
+import { Button, Flex, Text } from '@/adapters/ui'
+import type { ConnectorInfo } from '@/adapters/api'
+import { getConnectorPicker, type SignInBlock } from '@/features/documents'
+
+const pageOrigin = (): string => (typeof window === 'undefined' ? '' : window.location.origin)
+
+const NOT_SET_UP: SignInBlock = { reason: 'Not set up on this installation yet.' }
+
+const blockedHere = (connector: ConnectorInfo): SignInBlock | null =>
+  connector.configured
+    ? (getConnectorPicker(connector.id)?.blockedAt(connector.config, pageOrigin()) ?? null)
+    : NOT_SET_UP
+
+const noteId = (connector: ConnectorInfo): string => `connector-note-${connector.id}`
+
+interface ConnectorImportButtonsProps {
+  connectors: ConnectorInfo[]
+  onImport: (connector: ConnectorInfo) => Promise<void>
+  disabled?: boolean
+}
+
+export const ConnectorImportButtons: FC<ConnectorImportButtonsProps> = ({
+  connectors,
+  onImport,
+  disabled = false,
+}) => {
+  const [busy, setBusy] = useState<ReadonlySet<string>>(new Set())
+  const runs = useRef(new Map<string, number>())
+
+  // An open store's button stays clickable: a sign-in window closed without finishing isn't always
+  // reported, and clicking again starts over. Each store's latest click owns its busy state.
+  const handleClick = useCallback(
+    async (connector: ConnectorInfo) => {
+      const run = (runs.current.get(connector.id) ?? 0) + 1
+      runs.current.set(connector.id, run)
+      setBusy((open) => new Set(open).add(connector.id))
+      try {
+        await onImport(connector)
+      } finally {
+        if (runs.current.get(connector.id) === run) {
+          setBusy((open) => {
+            const next = new Set(open)
+            next.delete(connector.id)
+            return next
+          })
+        }
+      }
+    },
+    [onImport]
+  )
+
+  if (connectors.length === 0) return null
+
+  return (
+    <Flex gap="2" align="center" className="flex-wrap">
+      {connectors.map((connector) => {
+        const blocked = blockedHere(connector)
+        return (
+          <Button
+            key={connector.id}
+            kind="tertiary"
+            size="small"
+            onClick={() => handleClick(connector)}
+            disabled={disabled || blocked !== null}
+            title={
+              blocked
+                ? `${blocked.reason} ${blocked.command ?? ''}`.trim()
+                : busy.has(connector.id)
+                  ? `Closed the ${connector.name} window? Click to start over.`
+                  : undefined
+            }
+            aria-label={`Import files from ${connector.name}`}
+            aria-describedby={blocked ? noteId(connector) : undefined}
+          >
+            {busy.has(connector.id)
+              ? `Opening ${connector.name}…`
+              : `Import from ${connector.name}`}
+          </Button>
+        )
+      })}
+    </Flex>
+  )
+}
+
+/** For each store whose sign-in can't work from this page, why and what to do */
+export const ConnectorSignInNotes: FC<{ connectors: ConnectorInfo[] }> = ({ connectors }) => {
+  const notes = useMemo(
+    () =>
+      connectors.flatMap((connector) => {
+        const blocked = blockedHere(connector)
+        return blocked ? [{ connector, blocked }] : []
+      }),
+    [connectors]
+  )
+
+  if (notes.length === 0) return null
+
+  return (
+    <Flex direction="col" gap="2">
+      {notes.map(({ connector, blocked }) => (
+        <Text
+          key={connector.id}
+          id={noteId(connector)}
+          kind="body/regular/sm"
+          className="text-subtle"
+        >
+          {connector.name}: {blocked.reason}
+          {blocked.command && (
+            <code className="bg-surface-sunken mt-1 block select-all rounded px-2 py-1 font-mono text-xs">
+              {blocked.command}
+            </code>
+          )}
+        </Text>
+      ))}
+    </Flex>
+  )
+}
