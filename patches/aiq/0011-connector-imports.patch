+// SPDX-License-Identifier: Apache-2.0
+
+import { describe, test, expect, vi, beforeEach, afterEach } from 'vitest'
+
+vi.mock('./load-script', () => ({ loadScript: vi.fn(() => Promise.resolve()) }))
+
+import { googleDrivePicker, resetGoogleDriveForTests, PICKABLE_MIME_TYPES } from './google-drive'
+import { PickerError } from './types'
+
+const CONFIG = {
+  client_id: '1234-abc.apps.googleusercontent.com',
+  api_key: 'AIza-key',
+  app_id: '123456789012',
+  scope: 'https://www.googleapis.com/auth/drive.file',
+  origins: [window.location.origin, 'http://127.0.0.1:3000'],
+}
+
+type TokenReply = { access_token?: string; expires_in?: number; error?: string }
+type ErrorReply = { type: string; message?: string }
+type PickerReply = { action: string; docs?: { id: string; name?: string; sizeBytes?: number }[] }
+
+/** Google Identity Services and the Picker, answering with the replies queued per test */
+const fakeGoogle = () => {
+  const tokenReplies: (TokenReply | { failure: ErrorReply })[] = []
+  const pickerReplies: PickerReply[] = []
+  const prompts: (string | undefined)[] = []
+  const builders: Record<string, unknown>[] = []
+  let granted = true
+
+  const view = () => {
+    const v: Record<string, unknown> = { settings: {} }
+    for (const m of [
+      'setIncludeFolders',
+      'setSelectFolderEnabled',
+      'setMimeTypes',
+      'setMode',
+      'setEnableDrives',
+    ]) {
+      v[m] = (value: unknown) => {
+        ;(v.settings as Record<string, unknown>)[m] = value
+        return v
+      }
+    }
+    return v
+  }
+
+  class PickerBuilder {
+    calls: Record<string, unknown> = {}
+    callback: (data: PickerReply) => void = () => undefined
+    constructor() {
+      builders.push(this.calls)
+      for (const m of [
+        'addView',
+        'enableFeature',
+        'setOAuthToken',
+        'setDeveloperKey',
+        'setAppId',
+        'setOrigin',
+        'setTitle',
+        'setMaxItems',
+      ]) {
+        ;(this as unknown as Record<string, unknown>)[m] = (value: unknown) => {
+          const prior = this.calls[m]
+          this.calls[m] = prior === undefined ? value : [prior, value].flat()
+          return this
+        }
+      }
+    }
+    setCallback(cb: (data: PickerReply) => void) {
+      this.callback = cb
+      return this
+    }
+    build() {
+      return {
+        setVisible: () => {
+          const reply = pickerReplies.shift() ?? { action: 'cancel' }
+          queueMicrotask(() => this.callback(reply))
+        },
+        dispose: vi.fn(),
+      }
+    }
+  }
+
+  window.gapi = {
+    load: (_api, options) => options.callback(),
+  }
+  window.google = {
+    accounts: {
+      oauth2: {
+        initTokenClient: (config) => ({
+          requestAccessToken: (overrides) => {
+            prompts.push(overrides?.prompt)
+            const reply = tokenReplies.shift() ?? { failure: { type: 'popup_closed' } }
+            queueMicrotask(() =>
+              'failure' in reply ? config.error_callback?.(reply.failure) : config.callback(reply)
+            )
+          },
+        }),
+        hasGrantedAllScopes: () => granted,
+        revoke: vi.fn(),
+      },
+    },
+    picker: {
+      DocsView: function DocsView() {
+        return view()
+      } as unknown as new () => never,
+      PickerBuilder: PickerBuilder as unknown as new () => never,
+      ViewId: { DOCS: 'all' },
+      DocsViewMode: { LIST: 'list' },
+      Feature: { MULTISELECT_ENABLED: 'multiselect', SUPPORT_DRIVES: 'drives' },
+      Action: { PICKED: 'picked', CANCEL: 'cancel' },
+    },
+  }
+
+  return {
+    tokenReplies,
+    pickerReplies,
+    prompts,
+    builders,
+    deny: () => {
+      granted = false
+    },
+  }
+}
+
+describe('googleDrivePicker', () => {
+  let google: ReturnType<typeof fakeGoogle>
+
+  beforeEach(() => {
+    resetGoogleDriveForTests()
+    google = fakeGoogle()
+  })
+
+  afterEach(() => {
+    delete window.google
+    delete window.gapi
+  })
+
+  test('signs in, shows the picker, and returns the picked files with the token', async () => {
+    google.tokenReplies.push({ access_token: 'ya29.one', expires_in: 3599 })
+    google.pickerReplies.push({
+      action: 'picked',
+      docs: [
+        { id: 'abc1234567', name: 'Board memo', sizeBytes: 0 },
+        { id: 'def1234567', name: 'Q3.pdf', sizeBytes: 2048 },
+      ],
+    })
+
+    const result = await googleDrivePicker.pick(CONFIG, { maxItems: 7 })
+
+    expect(result).toEqual({
+      credential: 'ya29.one',
+      items: [
+        { id: 'abc1234567', name: 'Board memo', sizeBytes: 0 },
+        { id: 'def1234567', name: 'Q3.pdf', sizeBytes: 2048 },
+      ],
+    })
+    expect(google.prompts).toEqual(['select_account'])
+    const picker = google.builders[0]
+    expect(picker.setOAuthToken).toBe('ya29.one')
+    expect(picker.setDeveloperKey).toBe('AIza-key')
+    expect(picker.setAppId).toBe('123456789012')
+    expect(picker.setMaxItems).toBe(7)
+    expect(picker.enableFeature).toEqual(['multiselect', 'drives'])
+    expect(picker.setOrigin).toBe(`${window.location.protocol}//${window.location.host}`)
+  })
+
+  test('only readable types and browsable folders are offered, never folder selection', async () => {
+    google.tokenReplies.push({ access_token: 'ya29.one', expires_in: 3599 })
+    google.pickerReplies.push({ action: 'cancel' })
+    await googleDrivePicker.pick(CONFIG, { maxItems: 5 })
+
+    const views = google.builders[0].addView as { settings: Record<string, unknown> }[]
+    for (const v of views) {
+      expect(v.settings.setSelectFolderEnabled).toBe(false)
+      expect(v.settings.setMimeTypes).toBe(PICKABLE_MIME_TYPES.join(','))
+    }
+    expect(PICKABLE_MIME_TYPES).not.toContain('image/png')
+  })
+
+  test('reuses a live token instead of opening sign-in again', async () => {
+    google.tokenReplies.push({ access_token: 'ya29.one', expires_in: 3599 })
+    google.pickerReplies.push({ action: 'picked', docs: [{ id: 'abc1234567', name: 'a' }] })
+    google.pickerReplies.push({ action: 'picked', docs: [{ id: 'def1234567', name: 'b' }] })
+
+    await googleDrivePicker.pick(CONFIG, { maxItems: 5 })
+    const second = await googleDrivePicker.pick(CONFIG, { maxItems: 5 })
+
+    expect(second?.credential).toBe('ya29.one')
+    expect(google.prompts).toHaveLength(1)
+  })
+
+  test('forget makes the next import choose an account again', async () => {
+    google.tokenReplies.push({ access_token: 'ya29.one', expires_in: 3599 })
+    google.tokenReplies.push({ access_token: 'ya29.two', expires_in: 3599 })
+    google.pickerReplies.push({ action: 'picked', docs: [{ id: 'abc1234567', name: 'a' }] })
+    google.pickerReplies.push({ action: 'picked', docs: [{ id: 'abc1234567', name: 'a' }] })
+
+    await googleDrivePicker.pick(CONFIG, { maxItems: 5 })
+    googleDrivePicker.forget()
+    const again = await googleDrivePicker.pick(CONFIG, { maxItems: 5 })
+
+    expect(again?.credential).toBe('ya29.two')
+    expect(google.prompts).toEqual(['select_account', 'select_account'])
+  })
+
+  test('closing sign-in or the picker is not an error', async () => {
+    google.tokenReplies.push({ failure: { type: 'popup_closed' } })
+    await expect(googleDrivePicker.pick(CONFIG, { maxItems: 5 })).resolves.toBeNull()
+
+    google.tokenReplies.push({ error: 'access_denied' })
+    await expect(googleDrivePicker.pick(CONFIG, { maxItems: 5 })).resolves.toBeNull()
+
+    google.tokenReplies.push({ access_token: 'ya29.one', expires_in: 3599 })
+    google.pickerReplies.push({ action: 'cancel' })
+    await expect(googleDrivePicker.pick(CONFIG, { maxItems: 5 })).resolves.toBeNull()
+  })
+
+  test('a blocked popup or refused scope says what to do', async () => {
+    google.tokenReplies.push({ failure: { type: 'popup_failed_to_open' } })
+    await expect(googleDrivePicker.pick(CONFIG, { maxItems: 5 })).rejects.toThrow(
+      'Allow pop-ups for this site'
+    )
+
+    google.deny()
+    google.tokenReplies.push({ access_token: 'ya29.one', expires_in: 3599 })
+    await expect(googleDrivePicker.pick(CONFIG, { maxItems: 5 })).rejects.toThrow(
+      'Allow access to the files you pick'
+    )
+  })
+
+  test('sign-in is offered only from the origins the OAuth client registered', () => {
+    const shipped = { ...CONFIG, origins: ['http://localhost:3000', 'http://127.0.0.1:3000'] }
+    expect(googleDrivePicker.blockedAt(shipped, 'http://localhost:3000')).toBeNull()
+    expect(googleDrivePicker.blockedAt(shipped, 'http://127.0.0.1:3000')).toBeNull()
+    expect(googleDrivePicker.blockedAt(shipped, 'http://10.32.48.44:3000')).toEqual({
+      reason:
+        'Google sign-in needs this app opened at http://localhost:3000, on the machine running it or through an SSH port forward:',
+      command: 'ssh -L 3000:localhost:3000 <user>@<host>',
+    })
+    expect(googleDrivePicker.blockedAt(shipped, 'http://localhost:3001')).not.toBeNull()
+    const other = { ...CONFIG, origins: ['http://localhost:8080'] }
+    expect(googleDrivePicker.blockedAt(other, 'http://box:8080')?.command).toBe(
+      'ssh -L 8080:localhost:8080 <user>@<host>'
+    )
+  })
+
+  test('picking from an origin Google would refuse explains instead of opening sign-in', async () => {
+    const elsewhere = { ...CONFIG, origins: ['http://127.0.0.1:3000'] }
+    await expect(googleDrivePicker.pick(elsewhere, { maxItems: 5 })).rejects.toThrow(
+      'ssh -L 3000:localhost:3000'
+    )
+    expect(google.prompts).toEqual([])
+  })
+
+  test('a server config missing a value is refused before anything loads', async () => {
+    await expect(
+      googleDrivePicker.pick({ ...CONFIG, api_key: '' }, { maxItems: 5 })
+    ).rejects.toBeInstanceOf(PickerError)
+  })
+})
