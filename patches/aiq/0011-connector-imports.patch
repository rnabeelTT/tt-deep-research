@@ -0,0 +1,64 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Connector pickers: the browser half of importing from a document store.
+ *
+ * The backend lists the connectors it knows (GET /v1/connectors), whether this install
+ * configured each, and each configured one's public config. A picker signs the user in to that store, lets them choose items, and
+ * hands back the item IDs plus a short-lived credential; the backend fetches the items.
+ * A new store needs one ConnectorPicker registered under the backend connector's ID.
+ */
+
+export interface PickedItem {
+  id: string
+  name: string
+  /** Size if the store reported one (0 for formats it exports, such as Google Docs) */
+  sizeBytes: number
+}
+
+/** A collection to import into, suggested by where the items were picked (a SharePoint library) */
+export interface CollectionSuggestion {
+  /** A collection name: lowercase letters, digits, - and _ */
+  name: string
+  /** For agents and people: what the collection holds */
+  description: string
+}
+
+export interface PickResult {
+  /** Short-lived credential the backend uses once, for these items only */
+  credential: string
+  items: PickedItem[]
+  suggestion?: CollectionSuggestion
+}
+
+export interface PickOptions {
+  /** Most items the user may choose in one go */
+  maxItems: number
+}
+
+/** Why the store's sign-in can't work from this page, and what to do instead */
+export interface SignInBlock {
+  reason: string
+  /** A command that fixes it, shown as code */
+  command?: string
+}
+
+export interface ConnectorPicker {
+  /** Null when sign-in works from a page at ORIGIN (e.g. http://localhost:3000) */
+  blockedAt(config: Record<string, unknown>, origin: string): SignInBlock | null
+  /** Load the store's scripts ahead of the click, so its sign-in popup opens in the click */
+  preload(config: Record<string, unknown>): Promise<void>
+  /** Sign in if needed and show the store's picker; null when the user closes either */
+  pick(config: Record<string, unknown>, options: PickOptions): Promise<PickResult | null>
+  /** Drop the cached sign-in, e.g. after the backend refused it */
+  forget(): void
+}
+
+/** A sign-in or picker failure the user can act on */
+export class PickerError extends Error {
+  constructor(message: string) {
+    super(message)
+    this.name = 'PickerError'
+  }
+}
