+                  className={`flex items-center gap-3 rounded px-2 py-1.5 text-sm ${why ? 'opacity-50' : 'hover:bg-surface-sunken'}`}
+                  title={why ?? undefined}
+                >
+                  <input
+                    type="checkbox"
+                    aria-label={`Select ${entry.name}`}
+                    checked={checked}
+                    disabled={Boolean(why) || (!checked && full)}
+                    onChange={() => toggle(entry)}
+                  />
+                  <span aria-hidden="true">{entry.folder ? '📁' : '📄'}</span>
+                  {entry.folder && !why ? (
+                    <button
+                      type="button"
+                      className="flex-1 truncate text-left hover:underline"
+                      onClick={() => openFolder(entry)}
+                    >
+                      {entry.name}
+                    </button>
+                  ) : (
+                    <span className="flex-1 truncate">{entry.name}</span>
+                  )}
+                  <span className="text-subtle w-20 text-right text-xs">
+                    {entry.folder
+                      ? `${entry.folder.childCount ?? ''} items`.trim()
+                      : formatSize(entry.size)}
+                  </span>
+                </li>
+              )
+            })}
+          </ul>
+          {more && !loading && (
+            <button
+              type="button"
+              className="text-brand m-2 text-sm hover:underline"
+              onClick={loadMore}
+            >
+              Show more
+            </button>
+          )}
+          {loading && <p className="text-subtle px-2 py-3 text-sm">Loading…</p>}
+        </div>
+
+        <div className="border-base flex items-center justify-between gap-3 border-t px-4 py-3">
+          <span className="text-subtle text-sm">
+            {picked.size === 0
+              ? 'Folders import the files inside them.'
+              : `${picked.size} selected${full ? ` (the most for one import)` : ''}`}
+          </span>
+          <div className="flex gap-2">
+            <button
+              type="button"
+              className="border-base rounded border px-3 py-1 text-sm"
+              onClick={() => onDone(null)}
+            >
+              Cancel
+            </button>
+            <button
+              type="button"
+              className="rounded bg-[var(--color-brand)] px-3 py-1 text-sm font-medium text-white disabled:opacity-50"
+              disabled={picked.size === 0}
+              onClick={() => onDone([...picked.values()], undefined, suggestFrom(trail))}
+            >
+              Import
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+  )
+}
+
+/** Show the browser over the page; resolves with the picked items, or null when closed */
+export const showOneDriveBrowser = (
+  props: Omit<OneDriveBrowserProps, 'onDone'>
+): Promise<Browsed | null> =>
+  new Promise((resolve, reject) => {
+    const host = document.createElement('div')
+    host.dataset.onedriveBrowser = ''
+    document.body.appendChild(host)
+    const root = createRoot(host)
+    let done = false
+    const onDone = (
+      items: PickedItem[] | null,
+      error?: Error,
+      suggestion?: CollectionSuggestion
+    ) => {
+      if (done) return
+      done = true
+      queueMicrotask(() => {
+        root.unmount()
+        host.remove()
+      })
+      if (error) reject(error)
+      else resolve(items ? { items, suggestion } : null)
+    }
+    const dialog: ReactNode = <OneDriveBrowser {...props} onDone={onDone} />
+    root.render(dialog)
+  })
