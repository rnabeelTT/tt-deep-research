+++ b/frontends/ui/src/adapters/api/documents-client.ts
@@ -16,8 +16,12 @@ import {
   FileListResponseSchema,
   UploadResponseSchema,
   IngestionJobStatusSchema,
+  ConnectorListResponseSchema,
+  ImportResponseSchema,
   type CollectionInfo,
+  type ConnectorList,
   type FileInfo,
+  type ImportResponse,
   type IngestionJobStatus,
 } from './documents-schemas'
 
@@ -59,6 +63,35 @@ async function handleApiError(response: Response, context: string): Promise<neve
   throw new Error(error?.error?.message || `${context}: ${response.statusText}`)
 }
 
+/**
+ * The backend's own `detail` from an error the /api/v1 proxy wrapped as
+ * "Backend returned <status>: <body>", so people see the reason rather than the wrapping.
+ */
+export async function readBackendDetail(response: Response, fallback: string): Promise<string> {
+  const body = await response.json().catch(() => ({}))
+  const message: unknown = body?.error?.message ?? body?.detail
+  if (typeof message !== 'string' || !message) return fallback
+  const wrapped = /^Backend returned \d+: ([\s\S]*)$/.exec(message)
+  if (!wrapped) return message
+  try {
+    const inner = JSON.parse(wrapped[1])
+    return typeof inner?.detail === 'string' && inner.detail ? inner.detail : fallback
+  } catch {
+    return fallback
+  }
+}
+
+/** An import the backend refused, with its HTTP status (401: sign in again) */
+export class ImportError extends Error {
+  constructor(
+    message: string,
+    readonly status: number
+  ) {
+    super(message)
+    this.name = 'ImportError'
+  }
+}
+
 // ============================================================================
 // Client Factory
 // ============================================================================
@@ -320,6 +353,114 @@ export const createDocumentsClient = (options: DocumentsClientOptions = {}) => {
       }
     },
 
+    // --------------------------------------------------------------------------
+    // Connectors (importing from document stores)
+    // --------------------------------------------------------------------------
+
+    /**
+     * Document stores this deployment can import from. A backend without connectors
+     * (or one that predates them) yields an empty list rather than an error.
+     */
+    async listConnectors(signal?: AbortSignal): Promise<ConnectorList> {
+      const none: ConnectorList = { connectors: [], preview: false }
+      const response = await fetch(`${getDocumentsBaseUrl()}/connectors`, {
+        method: 'GET',
+        headers: getHeaders(),
+        signal,
+      })
+      if (!response.ok) return none
+      const parsed = ConnectorListResponseSchema.safeParse(await response.json().catch(() => null))
+      return parsed.success ? parsed.data : none
+    },
+
+    /**
+     * Import items picked in a connector's picker into a collection. The credential goes to
+     * our backend once, in the body, and is not kept by the client.
+     */
+    async importItems(
+      collectionName: string,
+      connectorId: string,
+      credential: string,
+      itemIds: string[],
+      signal?: AbortSignal
+    ): Promise<ImportResponse> {
+      const url =
+        `${getCollectionsUrl()}/${encodeURIComponent(collectionName)}` +
+        `/import/${encodeURIComponent(connectorId)}`
+      const response = await fetch(url, {
+        method: 'POST',
+        headers: getHeaders(),
+        body: JSON.stringify({ credential, item_ids: itemIds }),
+        cache: 'no-store',
+        signal,
+      })
+      if (!response.ok) {
+        const detail = await readBackendDetail(response, `Import failed (${response.status})`)
+        throw new ImportError(detail, response.status)
+      }
+      return ImportResponseSchema.parse(await response.json())
+    },
+
+    /**
+     * Finish a sign-in for a store whose app has a secret (Lawmatics): the backend swaps the
+     * code for an access token and keeps nothing.
+     */
+    async connectorToken(
+      connectorId: string,
+      code: string,
+      verifier: string,
+      redirectUri: string,
+      signal?: AbortSignal
+    ): Promise<{ access_token: string; expires_in: number }> {
+      const response = await fetch(
+        `${getDocumentsBaseUrl()}/connectors/${encodeURIComponent(connectorId)}/token`,
+        {
+          method: 'POST',
+          headers: getHeaders(),
+          body: JSON.stringify({ code, verifier, redirect_uri: redirectUri }),
+          cache: 'no-store',
+          signal,
+        }
+      )
+      if (!response.ok) {
+        const detail = await readBackendDetail(response, `Sign-in failed (${response.status})`)
+        throw new ImportError(detail, response.status)
+      }
+      const body = (await response.json()) as { access_token?: unknown; expires_in?: unknown }
+      if (typeof body.access_token !== 'string' || !body.access_token) {
+        throw new ImportError('Sign-in returned no token', 502)
+      }
+      const expires = typeof body.expires_in === 'number' ? body.expires_in : 3600
+      return { access_token: body.access_token, expires_in: expires }
+    },
+
+    /**
+     * One page of a store's browser, listed by the backend with the user's credential (for
+     * stores whose API a web page can't call). The shape of REQUEST and the answer is the store's.
+     */
+    async browseConnector<T>(
+      connectorId: string,
+      credential: string,
+      request: Record<string, unknown>,
+      signal?: AbortSignal
+    ): Promise<T> {
+      const response = await fetch(
+        `${getDocumentsBaseUrl()}/connectors/${encodeURIComponent(connectorId)}/browse`,
+        {
+          method: 'POST',
+          headers: getHeaders(),
+          body: JSON.stringify({ credential, request }),
+          cache: 'no-store',
+          signal,
+        }
+      )
+      if (!response.ok) {
+        const detail = await readBackendDetail(response, `Listing failed (${response.status})`)
+        throw new ImportError(detail, response.status)
+      }
+      return (await response.json()) as T
+    },
+
     // --------------------------------------------------------------------------
     // Job Status (Polling)
     // --------------------------------------------------------------------------
