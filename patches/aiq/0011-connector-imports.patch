+
+  test('declining consent cancels quietly; other errors say why', async () => {
+    const declined = await pickAndReturn((state) => ({ error: 'access_denied', state }))
+    expect(declined.result).toBeNull()
+    expect(mockToken).not.toHaveBeenCalled()
