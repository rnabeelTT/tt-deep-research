@@ -0,0 +1,354 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Lawmatics browser: the firm's matters (searchable), each matter's files, and a pick of files
+ * or whole matters. Listing goes through our backend with the user's token. Picks from one matter
+ * suggest a collection named after it.
+ */
+
+'use client'
+
+import { type FC, type ReactNode, useCallback, useEffect, useRef, useState } from 'react'
+import { createRoot } from 'react-dom/client'
+import { createDocumentsClient, ImportError } from '@/adapters/api'
+import { collectionName } from './onedrive-browser'
+import { PickerError, type CollectionSuggestion, type PickedItem } from './types'
+
+export interface Matter {
+  id: string
+  name: string
+  status?: string
+}
+
+export interface MatterFile {
+  id: string
+  name: string
+  size: number
+  updated_at?: string
+  importable: boolean
+}
+
+interface MattersPage {
+  matters: Matter[]
+  more: boolean
+  next_page?: number
+}
+
+interface FilesPage {
+  files: MatterFile[]
+  more: boolean
+}
+
+export interface LawmaticsBrowserProps {
+  token: string
+  maxItems: number
+  importable: string[]
+  onDone: (items: PickedItem[] | null, error?: Error, suggestion?: CollectionSuggestion) => void
+  /** Test seam: lists through the backend by default */
+  browse?: <T>(request: Record<string, unknown>) => Promise<T>
+}
+
+export interface Browsed {
+  items: PickedItem[]
+  suggestion?: CollectionSuggestion
+}
+
+type View = { kind: 'matters' } | { kind: 'matter'; matter: Matter }
+
+const formatSize = (bytes: number): string => {
+  if (!bytes) return ''
+  if (bytes < 1024) return `${bytes} B`
+  if (bytes < 1024 ** 2) return `${Math.round(bytes / 1024)} KB`
+  return `${(bytes / 1024 ** 2).toFixed(1)} MB`
+}
+
+/** A collection named after the one matter every pick came from */
+export const suggestFor = (matters: Set<string>): CollectionSuggestion | undefined => {
+  if (matters.size !== 1) return undefined
+  const [name] = matters
+  const slug = collectionName(name)
+  return slug ? { name: slug, description: `Lawmatics matter ${name}` } : undefined
+}
+
+export const LawmaticsBrowser: FC<LawmaticsBrowserProps> = ({
+  token,
+  maxItems,
+  onDone,
+  browse: browseOverride,
+}) => {
+  const [view, setView] = useState<View>({ kind: 'matters' })
+  const [query, setQuery] = useState('')
+  const [searching, setSearching] = useState('')
+  const [matters, setMatters] = useState<Matter[]>([])
+  const [files, setFiles] = useState<MatterFile[]>([])
+  const [next, setNext] = useState<number | null>(null)
+  const [loading, setLoading] = useState(true)
+  const [error, setError] = useState<string | null>(null)
+  const [picked, setPicked] = useState<Map<string, PickedItem & { matter: string }>>(new Map())
+  const searchRef = useRef<HTMLInputElement>(null)
+  const full = picked.size >= maxItems
+
+  const browse = useCallback(
+    <T,>(request: Record<string, unknown>): Promise<T> =>
+      browseOverride
+        ? browseOverride<T>(request)
+        : createDocumentsClient({}).browseConnector<T>('lawmatics', token, request),
+    [browseOverride, token]
+  )
+
+  const load = useCallback(
+    async (page: number, append: boolean) => {
+      setLoading(true)
+      setError(null)
+      try {
+        if (view.kind === 'matters') {
+          const got = await browse<MattersPage>({ kind: 'matters', query: searching, page })
+          setMatters((m) => (append ? [...m, ...got.matters] : got.matters))
+          setNext(got.more ? (got.next_page ?? page + 1) : null)
+        } else {
+          const got = await browse<FilesPage>({ kind: 'files', matter: view.matter.id, page })
+          setFiles((f) => (append ? [...f, ...got.files] : got.files))
+          setNext(got.more ? page + 1 : null)
+        }
+      } catch (err) {
+        if (err instanceof ImportError && err.status === 401) {
+          onDone(null, new PickerError('Lawmatics sign-in expired; import again to sign in'))
+          return
+        }
+        setError(err instanceof Error ? err.message : 'Lawmatics is unavailable')
+      } finally {
+        setLoading(false)
+      }
+    },
+    [browse, onDone, searching, view]
+  )
+
+  useEffect(() => {
+    void load(1, false)
+  }, [load])
+
+  useEffect(() => {
+    searchRef.current?.focus()
+    const onKey = (e: KeyboardEvent) => e.key === 'Escape' && onDone(null)
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [onDone])
+
+  const toggle = (id: string, name: string, size: number, matter: string) =>
+    setPicked((current) => {
+      const nextPicked = new Map(current)
+      if (nextPicked.has(id)) nextPicked.delete(id)
+      else if (nextPicked.size < maxItems) nextPicked.set(id, { id, name, sizeBytes: size, matter })
+      return nextPicked
+    })
+
+  const finish = () => {
+    const items = [...picked.values()].map(({ id, name, sizeBytes }) => ({ id, name, sizeBytes }))
+    onDone(items, undefined, suggestFor(new Set([...picked.values()].map((p) => p.matter))))
+  }
+
+  const row = (key: string, children: ReactNode, dim = false, title?: string) => (
+    <li
+      key={key}
+      title={title}
+      className={`flex items-center gap-3 rounded px-2 py-1.5 text-sm ${dim ? 'opacity-50' : 'hover:bg-surface-sunken'}`}
+    >
+      {children}
+    </li>
+  )
+
+  return (
+    <div
+      className="fixed inset-0 z-[1000] flex items-center justify-center bg-black/50 p-4"
+      onMouseDown={(e) => e.target === e.currentTarget && onDone(null)}
+    >
+      <div
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="lawmatics-browser-title"
+        className="border-base bg-surface-raised text-primary flex max-h-[80vh] w-full max-w-2xl flex-col rounded-lg border shadow-xl"
+      >
+        <div className="border-base flex items-center justify-between gap-3 border-b px-4 py-3">
+          <h2 id="lawmatics-browser-title" className="text-base font-semibold">
+            Choose files from Lawmatics
+          </h2>
+          {view.kind === 'matters' && (
+            <form
+              role="search"
+              className="flex-1"
+              onSubmit={(e) => {
+                e.preventDefault()
+                setSearching(query.trim())
+              }}
+            >
+              <input
+                ref={searchRef}
+                type="search"
+                value={query}
+                onChange={(e) => {
+                  setQuery(e.target.value)
+                  if (!e.target.value.trim()) setSearching('')
+                }}
+                placeholder="Search matters"
+                aria-label="Search matters"
+                className="border-base bg-surface-base w-full rounded border px-2 py-1 text-sm"
+              />
+            </form>
+          )}
+        </div>
+
+        <nav aria-label="Matter" className="text-subtle flex items-center gap-1 px-4 py-2 text-sm">
+          {view.kind === 'matters' ? (
+            <span className="text-primary">
+              {searching ? `Matters matching “${searching}”` : 'Matters'}
+            </span>
+          ) : (
+            <>
+              <button
+                type="button"
+                className="hover:underline"
+                onClick={() => setView({ kind: 'matters' })}
+              >
+                Matters
+              </button>
+              <span aria-hidden="true">›</span>
+              <span className="text-primary">{view.matter.name}</span>
+            </>
+          )}
+        </nav>
+
+        <div className="min-h-[16rem] flex-1 overflow-y-auto px-2" aria-busy={loading}>
+          {error && <p className="text-error px-2 py-3 text-sm">{error}</p>}
+          {!error && !loading && view.kind === 'matters' && matters.length === 0 && (
+            <p className="text-subtle px-2 py-3 text-sm">
+              {searching ? 'No matters match.' : 'No matters.'}
+            </p>
+          )}
+          {!error && !loading && view.kind === 'matter' && files.length === 0 && (
+            <p className="text-subtle px-2 py-3 text-sm">This matter has no files.</p>
+          )}
+
+          {view.kind === 'matters' ? (
+            <ul aria-label="Matters">
+              {matters.map((m) => {
+                const id = `matter:${m.id}`
+                const checked = picked.has(id)
+                return row(
+                  id,
+                  <>
+                    <input
+                      type="checkbox"
+                      aria-label={`Select all files of ${m.name}`}
+                      checked={checked}
+                      disabled={!checked && full}
+                      onChange={() => toggle(id, m.name, 0, m.name)}
+                    />
+                    <span aria-hidden="true">⚖️</span>
+                    <button
+                      type="button"
+                      className="flex-1 truncate text-left hover:underline"
+                      onClick={() => setView({ kind: 'matter', matter: m })}
+                    >
+                      {m.name}
+                    </button>
+                    <span className="text-subtle text-xs">{m.status}</span>
+                  </>
+                )
+              })}
+            </ul>
+          ) : (
+            <ul aria-label="Files">
+              {files.map((f) => {
+                const id = `file:${f.id}`
+                const checked = picked.has(id)
+                const why = f.importable ? undefined : 'This type can’t be imported'
+                return row(
+                  id,
+                  <>
+                    <input
+                      type="checkbox"
+                      aria-label={`Select ${f.name}`}
+                      checked={checked}
+                      disabled={Boolean(why) || (!checked && full)}
+                      onChange={() => toggle(id, f.name, f.size, view.matter.name)}
+                    />
+                    <span aria-hidden="true">📄</span>
+                    <span className="flex-1 truncate">{f.name}</span>
+                    <span className="text-subtle w-20 text-right text-xs">
+                      {formatSize(f.size)}
+                    </span>
+                  </>,
+                  Boolean(why),
+                  why
+                )
+              })}
+            </ul>
+          )}
+          {next !== null && !loading && (
+            <button
+              type="button"
+              className="text-brand m-2 text-sm hover:underline"
+              onClick={() => void load(next, true)}
+            >
+              Show more
+            </button>
+          )}
+          {loading && <p className="text-subtle px-2 py-3 text-sm">Loading…</p>}
+        </div>
+
+        <div className="border-base flex items-center justify-between gap-3 border-t px-4 py-3">
+          <span className="text-subtle text-sm">
+            {picked.size === 0
+              ? 'Tick a matter to import all its files, or open it to choose.'
+              : `${picked.size} selected${full ? ' (the most for one import)' : ''}`}
+          </span>
+          <div className="flex gap-2">
+            <button
+              type="button"
+              className="border-base rounded border px-3 py-1 text-sm"
+              onClick={() => onDone(null)}
+            >
+              Cancel
+            </button>
+            <button
+              type="button"
+              className="rounded bg-[var(--color-brand)] px-3 py-1 text-sm font-medium text-white disabled:opacity-50"
+              disabled={picked.size === 0}
+              onClick={finish}
+            >
+              Import
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+  )
+}
+
+/** Show the browser over the page; resolves with the picks, or null when closed */
+export const showLawmaticsBrowser = (
+  props: Omit<LawmaticsBrowserProps, 'onDone'>
+): Promise<Browsed | null> =>
+  new Promise((resolve, reject) => {
+    const host = document.createElement('div')
+    host.dataset.lawmaticsBrowser = ''
+    document.body.appendChild(host)
+    const root = createRoot(host)
+    let done = false
+    const onDone = (
+      items: PickedItem[] | null,
+      error?: Error,
+      suggestion?: CollectionSuggestion
+    ) => {
+      if (done) return
+      done = true
+      queueMicrotask(() => {
+        root.unmount()
+        host.remove()
+      })
+      if (error) reject(error)
+      else resolve(items ? { items, suggestion } : null)
+    }
+    root.render(<LawmaticsBrowser {...props} onDone={onDone} />)
+  })
