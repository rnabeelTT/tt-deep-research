+// SPDX-FileCopyrightText: Copyright (c) 2026, Tenstorrent. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Where Lawmatics' consent page returns (the Lawmatics connector's redirect URI): hands the code
+ * and state to the app tab that started the sign-in, then closes. It uses a same-origin
+ * BroadcastChannel, not window.opener: a consent page can cut the popup off from its opener.
+ */
+
+'use client'
+
+import { type ReactNode, useEffect, useState } from 'react'
+
+const LawmaticsRedirectPage = (): ReactNode => {
+  const [sent, setSent] = useState(false)
+
+  useEffect(() => {
+    const params = new URLSearchParams(window.location.search)
+    const channel = new BroadcastChannel('lawmatics-oauth') // read by connectors/lawmatics.ts
+    channel.postMessage({
+      code: params.get('code'),
+      state: params.get('state'),
+      error: params.get('error_description') || params.get('error'),
+    })
+    channel.close()
+    setSent(true)
+    window.close()
+  }, [])
+
+  return (
+    <main className="text-subtle flex min-h-screen items-center justify-center p-6 text-sm">
+      {sent ? 'This sign-in window can be closed.' : 'Signing in…'}
+    </main>
+  )
+}
+
+export default LawmaticsRedirectPage
